<%# ─── NAV ─────────────────────────────────────────────────────────────────── %>
<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100"
     data-controller="nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <%= image_tag "bearercore_logo.png", alt: "bearerCORE", class: "h-9 w-9 rounded-full" %>
      <span class="text-xl font-light tracking-wide" style="color: #0C1B38;">
        bearer<span class="font-bold" style="color: #C9A84C;">CORE</span><sup class="text-xs font-normal ml-0.5 opacity-50">™</sup>
      </span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      <a href="/portal" class="text-sm font-medium transition-colors hover:opacity-70" style="color: #0C1B38;">← Portal</a>
      <a href="/sandbox" class="text-sm font-medium transition-colors hover:opacity-70" style="color: #0C1B38;">Sandbox</a>
      <a href="/technical-overview" class="text-sm font-medium transition-colors hover:opacity-70" style="color: #0C1B38;">Technical Review</a>
      <div class="flex items-center gap-2 pl-4 border-l border-gray-100">
        <span class="flex items-center gap-1.5 text-xs font-medium" style="color: #6B7280;">
          <span class="w-1.5 h-1.5 rounded-full" style="background: #16a34a;"></span>
          Secure Session
        </span>
        <%= button_to "Logout", central_bank_logout_path, method: :delete,
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-all hover:opacity-80",
              style: "background: transparent; border-color: #0C1B38; color: #0C1B38; cursor: pointer;" %>
      </div>
    </div>
    <button class="md:hidden p-2" style="color: #0C1B38;" data-action="nav#toggle">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <div class="hidden" data-nav-target="menu">
    <div class="flex flex-col gap-4 px-6 pb-5 pt-2 border-t border-gray-100 bg-white">
      <a href="/portal" class="text-sm font-medium" style="color: #0C1B38;">← Portal</a>
      <a href="/sandbox" class="text-sm font-medium" style="color: #0C1B38;">Sandbox</a>
      <a href="/technical-overview" class="text-sm font-medium" style="color: #0C1B38;">Technical Review</a>
      <%= button_to "End Secure Session", central_bank_logout_path, method: :delete,
            class: "text-sm font-semibold px-5 py-2 rounded-full text-center",
            style: "background: transparent; border: 1.5px solid #0C1B38; color: #0C1B38; cursor: pointer;" %>
    </div>
  </div>
</nav>


<%# ─── HERO ──────────────────────────────────────────────────────────────────── %>
<section style="background: linear-gradient(160deg, #0C1B38 0%, #0f2347 60%, #0C1B38 100%); padding-top: 100px; padding-bottom: 48px; border-bottom: 1px solid rgba(201,168,76,0.2);">
  <div class="max-w-5xl mx-auto px-6">
    <%# Breadcrumb %>
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
      <a href="/portal" style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(201,168,76,0.6); text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='rgba(201,168,76,0.6)'">Administrator Console</a>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 2l4 4-4 4" stroke="rgba(201,168,76,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A84C;">License &amp; Provisioning</span>
    </div>

    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; flex-wrap: wrap;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(201,168,76,0.12); border: 1px solid rgba(201,168,76,0.3); border-radius: 100px; padding: 6px 16px; margin-bottom: 20px;">
          <span class="w-1.5 h-1.5 rounded-full" style="background: #16a34a; flex-shrink: 0;"></span>
          <span class="text-xs font-semibold tracking-widest uppercase" style="color: #C9A84C;">Module 03 &middot; License &amp; Provisioning</span>
        </div>
        <h1 style="color: #ffffff; font-size: clamp(1.8rem, 4vw, 2.75rem); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 12px; line-height: 1.15;">
          License &amp; Provisioning
        </h1>
        <p style="color: rgba(255,255,255,0.5); font-size: 1rem; max-width: 520px; margin: 0; line-height: 1.7;">
          Manage institutional access credentials, validate provisioned licenses, and monitor infrastructure entitlements for this bearerCORE deployment.
        </p>
      </div>

      <%# Global status badge %>
      <div style="background: rgba(22,163,74,0.12); border: 1px solid rgba(22,163,74,0.3); border-radius: 16px; padding: 20px 24px; flex-shrink: 0; min-width: 220px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
          <span style="width: 10px; height: 10px; background: #16a34a; border-radius: 50%; display: inline-block; box-shadow: 0 0 8px rgba(22,163,74,0.6);"></span>
          <span style="font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #4ade80;">Valid &amp; Active</span>
        </div>
        <div style="font-size: 22px; font-weight: 700; color: #ffffff; margin-bottom: 4px;"><%= @active_count %> / <%= [@total_count, 1].max %></div>
        <div style="font-size: 11px; color: rgba(255,255,255,0.4);">Active provisioned licenses</div>
        <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.08);">
          <div style="font-size: 10px; color: rgba(255,255,255,0.3); letter-spacing: 0.06em; text-transform: uppercase;">Infrastructure</div>
          <div style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 3px; font-weight: 500;">bearerCORE™ Sovereign Node</div>
        </div>
      </div>
    </div>
  </div>
</section>


<%# ─── MAIN CONTENT ──────────────────────────────────────────────────────────── %>
<section style="background: #0f1e3a; padding: 56px 24px 96px;">
  <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 40px;">


    <%# ── SECTION 1: Infrastructure Capacity Meters ── %>
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(201,168,76,0.5)" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span style="font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.3);">Infrastructure Entitlements</span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">

        <%# Meter: Active Corridor Gateways %>
        <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(201,168,76,0.18); border-radius: 16px; padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <span style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.6);">Corridor Gateways</span>
            <span style="font-size: 11px; font-weight: 700; color: #C9A84C;">02 / 05</span>
          </div>
          <div style="height: 5px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
            <div style="height: 100%; width: 40%; background: linear-gradient(90deg, #C9A84C, #e8c76b); border-radius: 10px;"></div>
          </div>
          <div style="font-size: 10px; color: rgba(255,255,255,0.3);">40% utilisation · 3 available slots</div>
        </div>

        <%# Meter: Infrastructure Nodes %>
        <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(201,168,76,0.18); border-radius: 16px; padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <span style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.6);">Infrastructure Nodes</span>
            <span style="font-size: 11px; font-weight: 700; color: #C9A84C;">04 / 10</span>
          </div>
          <div style="height: 5px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
            <div style="height: 100%; width: 40%; background: linear-gradient(90deg, #C9A84C, #e8c76b); border-radius: 10px;"></div>
          </div>
          <div style="font-size: 10px; color: rgba(255,255,255,0.3);">40% utilisation · 6 available slots</div>
        </div>

        <%# Meter: Settlement Capacity %>
        <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(22,163,74,0.2); border-radius: 16px; padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <span style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.6);">Settlement Capacity</span>
            <span style="font-size: 11px; font-weight: 700; color: #4ade80;">24h</span>
          </div>
          <div style="height: 5px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
            <div style="height: 100%; width: 85%; background: linear-gradient(90deg, #16a34a, #4ade80); border-radius: 10px;"></div>
          </div>
          <div style="font-size: 10px; color: rgba(255,255,255,0.3);">T+0 settlement · Real-time finality</div>
        </div>

        <%# Meter: Cryptographic Signature Pack %>
        <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(201,168,76,0.18); border-radius: 16px; padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <span style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.6);">Signature Pack</span>
            <span style="font-size: 11px; font-weight: 700; color: #C9A84C;">Active</span>
          </div>
          <div style="height: 5px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-bottom: 8px;">
            <div style="height: 100%; width: 100%; background: linear-gradient(90deg, #C9A84C, #e8c76b); border-radius: 10px;"></div>
          </div>
          <div style="font-size: 10px; color: rgba(255,255,255,0.3);">Ed25519 · AES-256-GCM · Full entitlement</div>
        </div>

      </div>
    </div>


    <%# ── SECTION 2: Provisioned License Registry ── %>
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(201,168,76,0.5)" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span style="font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.3);">Provisioned License Registry</span>
      </div>

      <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(201,168,76,0.18); border-radius: 16px; overflow: hidden;">

        <%# Table header bar %>
        <div style="background: rgba(201,168,76,0.07); border-bottom: 1px solid rgba(201,168,76,0.15); padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5">
              <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
            </svg>
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: #C9A84C;">System Validation Logs</span>
          </div>
          <span style="font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.3); letter-spacing: 0.06em;"><%= @total_count %> record<%= @total_count == 1 ? '' : 's' %> total</span>
        </div>

        <% if @licenses.any? %>
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
              <thead>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                  <th style="padding: 12px 24px 12px 24px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">Institution</th>
                  <th style="padding: 12px 16px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">License ID</th>
                  <th style="padding: 12px 16px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">Type</th>
                  <th style="padding: 12px 16px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">Swift</th>
                  <th style="padding: 12px 16px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">Expires</th>
                  <th style="padding: 12px 16px; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); white-space: nowrap;">Status</th>
                </tr>
              </thead>
              <tbody>
                <% @licenses.each_with_index do |lic, i| %>
                  <tr style="border-bottom: 1px solid rgba(255,255,255,0.04); <%= i.even? ? 'background: rgba(255,255,255,0.01);' : '' %>">
                    <td style="padding: 14px 24px;">
                      <div style="color: rgba(255,255,255,0.85); font-weight: 600; white-space: nowrap;"><%= lic.centralbank.presence || lic.name %></div>
                      <div style="color: rgba(255,255,255,0.35); font-size: 11px; margin-top: 2px;"><%= lic.email %></div>
                    </td>
                    <td style="padding: 14px 16px;">
                      <code style="font-size: 11px; color: #C9A84C; background: rgba(201,168,76,0.1); padding: 2px 7px; border-radius: 4px; font-family: 'Courier New', monospace; white-space: nowrap;"><%= lic.licenseid.presence || '—' %></code>
                    </td>
                    <td style="padding: 14px 16px; color: rgba(255,255,255,0.55); white-space: nowrap;"><%= lic.license_type.presence || '—' %></td>
                    <td style="padding: 14px 16px; color: rgba(255,255,255,0.55); font-family: monospace; font-size: 11px; white-space: nowrap;"><%= lic.swiftcode.presence || '—' %></td>
                    <td style="padding: 14px 16px; color: rgba(255,255,255,0.55); white-space: nowrap;"><%= lic.duration ? lic.duration.strftime('%d %b %Y') : '—' %></td>
                    <td style="padding: 14px 16px;">
                      <% if lic.active %>
                        <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; color: #4ade80; background: rgba(22,163,74,0.12); border: 1px solid rgba(22,163,74,0.25); padding: 3px 9px; border-radius: 20px; text-transform: uppercase; white-space: nowrap;">
                          <span style="width: 5px; height: 5px; background: #4ade80; border-radius: 50%;"></span>
                          <%= lic.status.presence&.upcase || 'Active' %>
                        </span>
                      <% else %>
                        <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: 3px 9px; border-radius: 20px; text-transform: uppercase; white-space: nowrap;">
                          <%= lic.status.presence&.upcase || 'Inactive' %>
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div style="padding: 48px 24px; text-align: center;">
            <div style="width: 48px; height: 48px; background: rgba(201,168,76,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(201,168,76,0.5)" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <p style="color: rgba(255,255,255,0.35); font-size: 13px; margin: 0 0 4px;">No licenses provisioned yet</p>
            <p style="color: rgba(255,255,255,0.2); font-size: 11px; margin: 0;">Upload a <code style="font-size: 10px; background: rgba(255,255,255,0.06); padding: 1px 5px; border-radius: 3px;">.bclic</code> file below to register the first license</p>
          </div>
        <% end %>
      </div>
    </div>


    <%# ── SECTION 3: System Note + Actions ── %>
    <div style="display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; flex-wrap: wrap;">

      <%# System Note callout %>
      <div style="background: rgba(201,168,76,0.07); border: 1px solid rgba(201,168,76,0.2); border-left: 3px solid #C9A84C; border-radius: 12px; padding: 20px 24px;">
        <div style="display: flex; align-items: flex-start; gap: 12px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5" style="flex-shrink: 0; margin-top: 1px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C9A84C; margin-bottom: 6px;">System Note</div>
            <p style="color: rgba(255,255,255,0.55); font-size: 12.5px; line-height: 1.65; margin: 0;">
              License files are cryptographically signed by TowerPoint Group and bound to your institutional SWIFT code and registered IP range.
              Each <code style="font-size: 11px; background: rgba(255,255,255,0.08); padding: 1px 5px; border-radius: 3px;">.bclic</code> file carries an Ed25519 signature verified at node startup.
              Contact the bearerCORE protocol team to provision additional capacity or extend expiry dates.
            </p>
          </div>
        </div>
      </div>

      <%# Action buttons %>
      <div style="display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;">
        <button onclick="document.getElementById('upload-license-modal').style.display='flex'"
                style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #C9A84C; color: #0C1B38; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; padding: 12px 20px; border-radius: 10px; border: none; cursor: pointer; white-space: nowrap; transition: opacity 0.15s;"
                onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          Upload New License File
        </button>
        <a href="#"
           onclick="alert('Cryptographic receipt generation requires an active license record.'); return false;"
           style="display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); color: #C9A84C; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; padding: 12px 20px; border-radius: 10px; text-decoration: none; white-space: nowrap; transition: opacity 0.15s;"
           onmouseover="this.style.opacity='0.75'" onmouseout="this.style.opacity='1'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download Cryptographic Receipt
        </a>
      </div>

    </div>

  </div>
</section>


<%# ── UPLOAD MODAL ─────────────────────────────────────────────────────────── %>
<div id="upload-license-modal"
     style="display: none; position: fixed; inset: 0; z-index: 9999; align-items: center; justify-content: center; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);"
     onclick="if(event.target===this) this.style.display='none'">

  <div style="background: #0C1B38; border: 1px solid rgba(201,168,76,0.25); border-radius: 20px; padding: 0; width: 100%; max-width: 480px; margin: 24px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.5);">

    <%# Modal header %>
    <div style="background: rgba(201,168,76,0.08); border-bottom: 1px solid rgba(201,168,76,0.18); padding: 20px 28px; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 34px; height: 34px; background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.3); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </div>
        <div>
          <div style="font-size: 13px; font-weight: 700; color: #ffffff;">Upload License File</div>
          <div style="font-size: 10px; color: rgba(255,255,255,0.35); margin-top: 1px;">Accepts .bclic or .key format</div>
        </div>
      </div>
      <button onclick="document.getElementById('upload-license-modal').style.display='none'"
              style="background: none; border: none; cursor: pointer; color: rgba(255,255,255,0.4); padding: 4px;"
              onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <%# Modal body %>
    <div style="padding: 28px;">

      <%# Drop zone %>
      <div id="drop-zone"
           style="border: 2px dashed rgba(201,168,76,0.3); border-radius: 12px; padding: 36px 24px; text-align: center; margin-bottom: 20px; transition: border-color 0.15s, background 0.15s; cursor: pointer;"
           onclick="document.getElementById('license-file-input').click()"
           ondragover="event.preventDefault(); this.style.borderColor='#C9A84C'; this.style.background='rgba(201,168,76,0.06)'"
           ondragleave="this.style.borderColor='rgba(201,168,76,0.3)'; this.style.background='transparent'"
           ondrop="handleFileDrop(event)">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(201,168,76,0.5)" stroke-width="1.5" style="margin: 0 auto 12px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p style="color: rgba(255,255,255,0.6); font-size: 13px; font-weight: 600; margin: 0 0 4px;">Drop your license file here</p>
        <p style="color: rgba(255,255,255,0.3); font-size: 11px; margin: 0;">or click to browse · <code style="font-size: 10px; background: rgba(255,255,255,0.08); padding: 1px 5px; border-radius: 3px;">.bclic</code> / <code style="font-size: 10px; background: rgba(255,255,255,0.08); padding: 1px 5px; border-radius: 3px;">.key</code></p>
        <div id="selected-file-name" style="margin-top: 10px; font-size: 11px; color: #C9A84C; display: none;"></div>
      </div>
      <input type="file" id="license-file-input" accept=".bclic,.key" style="display: none;" onchange="showFileName(this)">

      <%# Admin password field %>
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255,255,255,0.5); margin-bottom: 8px;">Administrator Password</label>
        <input type="password" id="modal-admin-password" placeholder="Enter your administrator password"
               style="width: 100%; padding: 12px 14px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.1); border-radius: 10px; font-size: 13px; color: #fff; font-family: inherit; outline: none; transition: border-color 0.15s;"
               onfocus="this.style.borderColor='#C9A84C'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
      </div>

      <%# Submit %>
      <button onclick="submitLicenseUpload()"
              style="width: 100%; background: #C9A84C; color: #0C1B38; font-size: 13px; font-weight: 700; letter-spacing: 0.04em; padding: 14px; border-radius: 10px; border: none; cursor: pointer; transition: opacity 0.15s; font-family: inherit;"
              onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
        Validate &amp; Provision License
      </button>

      <p style="margin-top: 14px; font-size: 10px; color: rgba(255,255,255,0.25); text-align: center; line-height: 1.5;">
        License files are verified against the bearerCORE root Ed25519 public key before provisioning.
      </p>
    </div>
  </div>
</div>


<%# ── SESSION FOOTER STRIP ─────────────────────────────────────────────────── %>
<section style="background: #0a1628; border-top: 1px solid rgba(255,255,255,0.06); padding: 20px 24px;">
  <div style="max-width: 1000px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 20px;">
      <span style="font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600;">bearerCORE</span>
      <span style="font-size: 11px; color: rgba(255,255,255,0.2);">&middot;</span>
      <span style="font-size: 11px; color: rgba(255,255,255,0.3);">Administrator Console</span>
      <span style="font-size: 11px; color: rgba(255,255,255,0.2);">&middot;</span>
      <span style="font-size: 11px; color: rgba(255,255,255,0.3);">License &amp; Provisioning</span>
    </div>
    <%= button_to "End Session", central_bank_logout_path, method: :delete,
          style: "background: transparent; border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.4); font-size: 11px; font-weight: 600; padding: 6px 14px; border-radius: 6px; cursor: pointer; letter-spacing: 0.04em; text-transform: uppercase;" %>
  </div>
</section>


<script>
  function showFileName(input) {
    if (input.files && input.files[0]) {
      const el = document.getElementById('selected-file-name');
      el.textContent = '✓ ' + input.files[0].name;
      el.style.display = 'block';
    }
  }

  function handleFileDrop(event) {
    event.preventDefault();
    const zone = document.getElementById('drop-zone');
    zone.style.borderColor = 'rgba(201,168,76,0.3)';
    zone.style.background = 'transparent';
    const file = event.dataTransfer.files[0];
    if (file) {
      const el = document.getElementById('selected-file-name');
      el.textContent = '✓ ' + file.name;
      el.style.display = 'block';
    }
  }

  function submitLicenseUpload() {
    const fileInput = document.getElementById('license-file-input');
    const password = document.getElementById('modal-admin-password').value;
    if (!fileInput.files[0] && !document.getElementById('selected-file-name').textContent) {
      alert('Please select a license file (.bclic or .key) before provisioning.');
      return;
    }
    if (!password) {
      alert('Administrator password is required to provision a license.');
      return;
    }
    alert('License validation is in progress. This feature requires a signed .bclic file from the bearerCORE protocol team.');
  }
</script>
