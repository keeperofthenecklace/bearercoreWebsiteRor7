        <tbody>
          <tr><td><strong>Lock Liquidity</strong></td><td>Reserve Pool, Amount, 10M/50M/100M/MAX, Duration</td><td>Execute (blue)</td></tr>
          <tr><td><strong>Release Liquidity</strong></td><td>Lock ID selector, read-only Amount, Release Reason</td><td>Release Selected</td></tr>
          <tr><td><strong>Update FX Rate</strong></td><td>New Rate input, live % comparison, Effective Time</td><td>Propose Change (purple)</td></tr>
