<%# app/views/docs/index.html.erb — Documentation Portal: Module Index %>

<%= render 'docs/doc_styles' %>

<style>
  /* ── Segmented toggle ─────────────────────────────────────────────────── */
  .dp-seg-wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .dp-seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1.5px solid #dde1ef;
    border-radius: 14px;
    overflow: hidden;
    background: #f5f7fc;
  }
  .dp-seg-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 24px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    border: none;
    background: transparent;
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    width: 100%;
  }
  .dp-seg-btn:first-child {
    border-right: 1.5px solid #dde1ef;
  }
  .dp-seg-btn.active {
    background: #0a1628;
  }
  .dp-seg-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .dp-seg-btn .dp-seg-icon       { background: #dde1ef; }
  .dp-seg-btn.active .dp-seg-icon { background: rgba(255,255,255,0.12); }
  .dp-seg-label { font-size: 14px; font-weight: 700; color: #7a7f9a; line-height: 1.3; }
  .dp-seg-sub   { font-size: 11px; color: #a0a5b8; font-weight: 400; margin-top: 2px; }
  .dp-seg-btn.active .dp-seg-label { color: #fff; }
  .dp-seg-btn.active .dp-seg-sub   { color: rgba(255,255,255,0.55); }

  /* ── Tab panels ──────────────────────────────────────────────────────── */
  .dp-tab-panel {
    display: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .dp-tab-panel.active {
    display: block;
    opacity: 1;
  }

  /* ── Scope meta bar ──────────────────────────────────────────────────── */
  .dp-scope-bar {
    max-width: 1060px;
    margin: 24px auto 0;
    padding: 0 48px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-size: 13px;
    color: #7a7f9a;
  }
  .dp-scope-bar b { color: #0a1628; }
</style>

