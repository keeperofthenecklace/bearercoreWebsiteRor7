<!-- Shared card styles (inlined to avoid touching _doc_styles partial) -->
<style>
  .dp-card-inner {
    background: #fff;
    border: 1px solid #dde1ef;
    border-radius: 12px;
    padding: 28px 24px;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    box-sizing: border-box;
  }
  .dp-card-icon {
    width: 44px; height: 44px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
  }
  .dp-card-title  { font-size: 16px; font-weight: 700; color: #0a1628; margin-bottom: 6px; }
  .dp-card-desc   { font-size: 13px; color: #4a4f6a; line-height: 1.6; }
  .dp-card-tags   { display: flex; gap: 8px; flex-wrap: wrap; }
  .dp-card-cta    { font-size: 13px; font-weight: 600; color: #0a1628; margin-top: 4px; }
  .dp-tag         { background: #f0f2f8; color: #4a4f6a; font-size: 11px; padding: 2px 8px; border-radius: 4px; }
  .dp-badge-complete { background:#e8f5e9; color:#1b5e20; font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; letter-spacing:0.05em; }
  .dp-badge-progress { background:#fff8e1; color:#e65100; font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; letter-spacing:0.05em; }
  .dp-badge-soon     { background:#f0f2f8; color:#7a7f9a; font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; letter-spacing:0.05em; }
</style>

<script>
  function switchTab(tab) {
    // Toggle buttons
    document.getElementById('btn-web').classList.toggle('active', tab === 'web');
    document.getElementById('btn-qt6').classList.toggle('active', tab === 'qt6');

    // Crossfade panels
    const webPanel = document.getElementById('panel-web');
    const qt6Panel = document.getElementById('panel-qt6');

    if (tab === 'web') {
      qt6Panel.style.opacity = '0';
      qt6Panel.classList.remove('active');
      webPanel.classList.add('active');
      requestAnimationFrame(() => { webPanel.style.opacity = '1'; });
      document.getElementById('scopeText').innerHTML = 'Scope: <b>Central Bank Web Node, API Nodes</b>';
    } else {
      webPanel.style.opacity = '0';
      webPanel.classList.remove('active');
      qt6Panel.classList.add('active');
      requestAnimationFrame(() => { qt6Panel.style.opacity = '1'; });
      document.getElementById('scopeText').innerHTML = 'Scope: <b>Native Client Apps &amp; Cryptographic Tooling</b>';
    }
  }
</script>
