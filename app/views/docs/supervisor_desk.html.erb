          <tr><td><strong>CorridorProtocolVerified</strong></td><td>Step 2 — CorridorVerificationService → ready_to_mint</td><td>claim_id, corridor_id, earmarked_amount, corridor_headroom_at_verification, asset_code, verification_checked_at</td><td>bearerCORE issuance auth, settlement service, audit log</td></tr>
          <tr><td><strong>CorridorLiquidityInsufficient</strong></td><td>Step 2 — CorridorVerificationService → insufficient_corridor_liquidity</td><td>claim_id, corridor_id, required_amount, available_headroom, shortfall, verification_note</td><td>Governor's Desk alert, audit log</td></tr>
