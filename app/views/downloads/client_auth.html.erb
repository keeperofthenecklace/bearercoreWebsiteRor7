<%# ─── NAV ─────────────────────────────────────────────────────────────────── %>
<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100" data-controller="nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <%= image_tag "bearercore_logo.png", alt: "bearerCORE", class: "h-9 w-9 rounded-full" %>
      <span class="text-xl font-light tracking-wide" style="color: #0C1B38;">
        bearer<span class="font-bold" style="color: #C9A84C;">CORE</span><sup class="text-xs font-normal ml-0.5 opacity-50">™</sup>
      </span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      <a href="/sandbox" class="text-sm font-medium hover:opacity-70" style="color: #0C1B38;">Sandbox</a>
      <a href="/technical-overview" class="text-sm font-medium hover:opacity-70" style="color: #0C1B38;">Technical Review</a>
      <div class="flex items-center gap-2 pl-4 border-l border-gray-100">
        <span class="flex items-center gap-1.5 text-xs font-medium" style="color: #6B7280;">
          <span class="w-1.5 h-1.5 rounded-full" style="background: #16a34a;"></span>
          Secure Session
        </span>
        <%= button_to "Logout", central_bank_logout_path, method: :delete,
              class: "text-xs font-semibold px-3 py-1.5 rounded-lg border transition-all hover:opacity-80",
              style: "background: transparent; border-color: #0C1B38; color: #0C1B38; cursor: pointer;" %>
      </div>
    </div>
  </div>
</nav>

<%# ─── SUB-NAV ─────────────────────────────────────────────────────────────── %>
<div style="position: fixed; top: 65px; left: 0; right: 0; z-index: 40; background: #0C1B38; border-bottom: 1px solid rgba(255,255,255,0.08);">
  <div class="max-w-7xl mx-auto px-6" style="display: flex; align-items: center; gap: 24px; height: 40px;">
    <a href="/portal" style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.45); letter-spacing: 0.05em; text-decoration: none; display: flex; align-items: center; gap: 5px;" onmouseover="this.style.color='rgba(255,255,255,0.75)'" onmouseout="this.style.color='rgba(255,255,255,0.45)'">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      DASHBOARD
    </a>
    <span style="color: rgba(255,255,255,0.15); font-size: 11px;">/</span>
    <span style="font-size: 11px; font-weight: 700; color: #C9A84C; letter-spacing: 0.05em;">SOFTWARE DOWNLOAD</span>
  </div>
</div>

<%# ─── PAGE ────────────────────────────────────────────────────────────────── %>
<div style="min-height: 100vh; background: #0a1628; padding-top: 130px; padding-bottom: 80px; display: flex; align-items: center; justify-content: center;">
  <div style="width: 100%; max-width: 520px; padding: 0 24px;">

    <% if flash[:error] %>
      <div style="background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.3); border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; color: #fca5a5; font-size: 13px;">
        <%= flash[:error] %>
      </div>
    <% end %>

    <%# Download card %>
    <div style="background: linear-gradient(160deg, #111c35 0%, #0e1d38 100%); border: 1px solid rgba(201,168,76,0.25); border-radius: 20px; overflow: hidden;">

      <%# Header %>
      <div style="background: linear-gradient(135deg, #0C1B38 0%, #152545 100%); padding: 28px 32px; text-align: center; border-bottom: 1px solid rgba(201,168,76,0.2);">
        <div style="width: 64px; height: 64px; background: rgba(201,168,76,0.12); border: 1px solid rgba(201,168,76,0.3); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.5">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
        <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A84C; margin-bottom: 6px;">bearerCORE™ Desktop Application</div>
        <h1 style="font-size: 22px; font-weight: 700; color: #ffffff; margin: 0; letter-spacing: -0.3px;">Download Client Software</h1>
      </div>

      <%# Meta badges %>
      <div style="display: flex; justify-content: center; gap: 12px; padding: 20px 32px 0; flex-wrap: wrap;">
        <span style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.45); background: rgba(255,255,255,0.06); padding: 4px 12px; border-radius: 6px;">14 MB</span>
        <span style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.45); background: rgba(255,255,255,0.06); padding: 4px 12px; border-radius: 6px;">Version 1.0.4 · Production</span>
        <span style="font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.45); background: rgba(255,255,255,0.06); padding: 4px 12px; border-radius: 6px;">Apple Silicon / Intel</span>
      </div>

      <%# Description %>
      <div style="padding: 16px 32px 0;">
        <p style="font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.65; margin: 0; text-align: center;">
          Standalone workstation node. Handles offline AES-256-GCM vault parsing and manages local Ed25519 cryptographic keys. Required for central bank operator signing workflows.
        </p>
      </div>

      <%# EULA form %>
      <div style="padding: 24px 32px 32px;">
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 16px; margin-bottom: 20px;">
          <p style="font-size: 12px; color: rgba(255,255,255,0.4); line-height: 1.6; margin: 0; text-align: center;">
            macOS 12.0 or later required. For institutional research and operational use only.
          </p>
        </div>

        <%= form_with url: process_client_download_path, method: :post, local: true do |f| %>
          <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; margin-bottom: 20px;">
            <%= f.check_box :eula_agreed, { style: "width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; accent-color: #C9A84C; cursor: pointer;" }, "1", "0" %>
            <span style="font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.55;">
              I have read and agree to the bearerCORE™
              <a href="/terms" target="_blank" style="color: #C9A84C; text-decoration: underline;">End-User License Agreement</a>.
              I understand this software is for institutional use only.
            </span>
          </label>

          <%= f.submit "Download .dmg Installer",
                style: "width: 100%; padding: 14px; background: #C9A84C; color: #0C1B38; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; transition: opacity 0.15s;",
                onmouseover: "this.style.opacity='0.88'",
                onmouseout:  "this.style.opacity='1'" %>
        <% end %>

        <p style="text-align: center; font-size: 11px; color: rgba(255,255,255,0.2); margin: 14px 0 0; letter-spacing: 0.03em;">
          SHA-256 integrity verified · Restricted to authenticated sessions
        </p>
      </div>

    </div>

    <div style="text-align: center; margin-top: 20px;">
      <a href="/portal" style="font-size: 12px; color: rgba(255,255,255,0.3); text-decoration: none;" onmouseover="this.style.color='rgba(255,255,255,0.6)'" onmouseout="this.style.color='rgba(255,255,255,0.3)'">
        ← Back to Portal
      </a>
    </div>

  </div>
</div>
