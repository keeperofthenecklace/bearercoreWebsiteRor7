<!DOCTYPE html>
<html lang="en">
  <head>
    <title>bearerCORE — Sovereign CBDC Infrastructure</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="bearerCORE is sovereign CBDC infrastructure for Central Banks. Send digital money instantly across Africa.">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# ── Institutional portal (hybrid) — bind the SmartcheqWebsiteRor7 identity ──
        The Doorkeeper token + institution profile were placed in the session by
        the central-bank-access auth bridge. Surface them for the Trade Claim modal:
        api-token drives getAccessToken(); SC_API_BASE routes claim submission to
        SmartcheqWebsiteRor7 (where the ABAC guard runs); SC_PORTAL locks the origin.
        SMARTCHEQ_BROWSER_API_BASE must point at the SmartcheqWebsiteRor7 API origin
        and that API's CORS must allow this origin, or the guard is not applied. %>
    <% if session[:access_token].present? %>
      <meta name="api-token" content="<%= session[:access_token] %>">
    <% end %>
    <%# Always-present fallback for the SmartcheqWebsiteRor7 API origin. Rendered
        unconditionally so the client can resolve the identity-authority base even
        when ENV isn't loaded under Passenger and no portal session is bound. %>
    <meta name="smartcheq-browser-api-base"
          content="<%= ENV.fetch('SMARTCHEQ_BROWSER_API_BASE', 'https://api.smartcheq.com') %>">
    <% if session[:institution_swift].present? %>
      <script>
        window.SC_API_BASE = <%= (ENV["SMARTCHEQ_BROWSER_API_BASE"].presence ||
                                  ENV["SMARTCHEQ_API_BASE"].presence ||
                                  (Rails.env.production? ? "https://api.smartcheq.com" : "http://127.0.0.1:3001")).to_json.html_safe %>;
        window.SC_PORTAL = {
          institution_swift:     <%= session[:institution_swift].to_json.html_safe %>,
          country_code:          <%= session[:country_code].to_json.html_safe %>,
          institution_name:      <%= (session[:institution_name] || session[:institution_swift]).to_json.html_safe %>,
          operator_username:     <%= session[:operator_username].to_json.html_safe %>,
          operator_display_name: <%= (session[:operator_display_name] || session[:operator_username]).to_json.html_safe %>
        };
      </script>
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="overscroll-none">
    <%= yield %>
  </body>
</html>
