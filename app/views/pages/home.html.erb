<!-- ─── LITEPAPER ACCESS MODAL ──────────────────────────────────────────────── -->
<div id="litepaperModalOverlay"
     style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:20px;width:100%;max-width:440px;margin:0 20px;box-shadow:0 32px 80px rgba(0,0,0,0.22);overflow:hidden;">

    <!-- Header -->
    <div style="background:linear-gradient(135deg,#0C1B38 0%,#152545 100%);padding:28px 28px 24px;">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <div style="width:32px;height:32px;background:rgba(201,168,76,0.18);border:1px solid rgba(201,168,76,0.35);border-radius:8px;display:flex;align-items:center;justify-content:center;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <span style="font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(201,168,76,0.8);">Restricted Document</span>
          </div>
          <h2 style="font-size:19px;font-weight:700;color:#fff;margin:0;line-height:1.3;letter-spacing:-0.3px;">
            Request Access to the<br>bearerCORE™ Technical Litepaper
          </h2>
        </div>
        <button onclick="closeLitepaperModal()" style="background:none;border:none;cursor:pointer;padding:2px;flex-shrink:0;color:rgba(255,255,255,0.4);" onmouseover="this.style.color='rgba(255,255,255,0.8)'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Body — form state -->
    <div id="litepaperForm" style="padding:24px 28px 28px;">
      <p style="font-size:13px;color:#6B7280;margin:0 0 20px;line-height:1.6;">
        The bearerCORE™ Technical Litepaper covers the sovereign protocol architecture,
        CVIB cryptographic pipeline, and cross-border settlement compliance model.
        Access is restricted to verified institutional stakeholders.
      </p>

      <label style="display:block;font-size:12px;font-weight:600;color:#0C1B38;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:6px;">
        Institutional Email Address
      </label>
      <input id="litepaperEmail" type="email" placeholder="you@centralbank.gov.gh"
             style="width:100%;padding:11px 14px;border:1.5px solid #e0e0e0;border-radius:10px;font-size:14px;color:#1d1d1f;outline:none;box-sizing:border-box;transition:border-color 0.15s;"
             onfocus="this.style.borderColor='#0C1B38'" onblur="this.style.borderColor='#e0e0e0'"
             onkeydown="if(event.key==='Enter') submitLitepaperRequest()"/>
      <p id="litepaperEmailHint" style="font-size:11.5px;color:#9CA3AF;margin:6px 0 0;line-height:1.5;">
        Central bank and government domains accepted (e.g. <code style="background:#f5f5f7;padding:1px 4px;border-radius:3px;">.gov.gh</code>, <code style="background:#f5f5f7;padding:1px 4px;border-radius:3px;">.cb.gov</code>)
      </p>
      <p id="litepaperEmailError" style="display:none;font-size:12px;color:#dc2626;margin:6px 0 0;font-weight:500;"></p>

      <button onclick="submitLitepaperRequest()"
              style="margin-top:20px;width:100%;padding:13px;background:linear-gradient(135deg,#0C1B38 0%,#1a3060 100%);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;letter-spacing:0.01em;transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
        Request Access
      </button>

      <p style="text-align:center;font-size:11.5px;color:#9CA3AF;margin:14px 0 0;line-height:1.5;">
        Your request is reviewed by the TowerPoint Group institutional relations team.<br>
        Approved parties receive secure download credentials within 2 business days.
      </p>
    </div>

    <!-- Body — success state -->
    <div id="litepaperSuccess" style="display:none;padding:32px 28px 36px;text-align:center;">
      <div style="width:56px;height:56px;background:#d1fae5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h3 style="font-size:17px;font-weight:700;color:#0C1B38;margin:0 0 10px;">Access Request Submitted</h3>
      <p style="font-size:13.5px;color:#6B7280;margin:0 0 20px;line-height:1.6;">
        Your request has been logged. The institutional relations team will review
        your credentials and respond within <strong>2 business days</strong>.
      </p>
      <button onclick="closeLitepaperModal()"
              style="padding:10px 28px;background:#0C1B38;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;opacity:0.9;"
              onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.9'">Close</button>
    </div>

  </div>
</div>

<script>
(function() {
  var INSTITUTIONAL_PATTERNS = [
    /\.gov\.[a-z]{2,}$/i,
    /\.cb\.gov$/i,
    /\.gov$/i,
    /\.mil$/i,
    /\.bank$/i,
    /centralbank\./i,
    /\.ng\.gov\./i,
    /\.rba\.gov\./i,
  ];
  var BLOCKED_DOMAINS = ['gmail','yahoo','hotmail','outlook','icloud','protonmail','aol'];

  window.openLitepaperModal = function() {
    document.getElementById('litepaperEmail').value = '';
    document.getElementById('litepaperEmailError').style.display = 'none';
    document.getElementById('litepaperForm').style.display = 'block';
    document.getElementById('litepaperSuccess').style.display = 'none';
    var o = document.getElementById('litepaperModalOverlay');
    o.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(function(){ document.getElementById('litepaperEmail').focus(); }, 80);
  };

  window.closeLitepaperModal = function() {
    document.getElementById('litepaperModalOverlay').style.display = 'none';
    document.body.style.overflow = '';
  };

  window.submitLitepaperRequest = function() {
    var email = (document.getElementById('litepaperEmail').value || '').trim().toLowerCase();
    var errEl = document.getElementById('litepaperEmailError');
    errEl.style.display = 'none';

    if (!email || !email.includes('@')) {
      errEl.textContent = 'Please enter a valid email address.';
      errEl.style.display = 'block';
      return;
    }
    var domain = email.split('@')[1] || '';
    var base = domain.split('.')[0];
    if (BLOCKED_DOMAINS.includes(base)) {
      errEl.textContent = 'Personal email addresses are not accepted. Please use your institutional address.';
      errEl.style.display = 'block';
      return;
    }
    var institutional = INSTITUTIONAL_PATTERNS.some(function(p){ return p.test(domain); });
    if (!institutional) {
      errEl.textContent = 'Please use an official institutional email (e.g. .gov.gh, .cb.gov, .gov). Personal or commercial domains are not eligible.';
      errEl.style.display = 'block';
      return;
    }
    document.getElementById('litepaperForm').style.display = 'none';
    document.getElementById('litepaperSuccess').style.display = 'block';
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLitepaperModal();
  });
  document.getElementById('litepaperModalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeLitepaperModal();
  });
})();
</script>

</div><%# /modal controller scope %>
