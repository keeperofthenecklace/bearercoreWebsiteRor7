  try {
    const response = await fetch('/admin-console/licenses-data', { headers: { 'Accept': 'application/json' } });
    if (response.ok) {
      const data = await response.json();
      allSoftwareLicences = data.software_licenses || data || [];
      populateLicencesNameFilter(allSoftwareLicences);
      renderSoftwareLicences(allSoftwareLicences);
    } else {
      tbody.innerHTML = '<tr><td colspan="10" style="padding:48px;text-align:center;color:#9ca3af;font-size:13px;">Could not load licences. Check API access.</td></tr>';
    }
  } catch (e) {
    console.error('[AdminConsole] loadSoftwareLicences error:', e);
    tbody.innerHTML = '<tr><td colspan="10" style="padding:48px;text-align:center;color:#9ca3af;font-size:13px;">No licence records found.</td></tr>';
  }
}

function populateLicencesNameFilter(licences) {
  const sel = document.getElementById('licencesNameFilter');
  if (!sel) return;
  const names = [...new Set(licences.map(l => l.name).filter(Boolean))].sort();
  sel.innerHTML = '<option value="">All Names</option>' + names.map(n => `<option value="${n}">${n}</option>`).join('');
}

function renderSoftwareLicences(licences) {
  const tbody = document.getElementById('licencesTableBody');
  const badge = document.getElementById('licencesCountBadge');
  const footer = document.getElementById('licencesFooterCount');
  if (!tbody) return;
  if (badge) badge.textContent = licences.length;
  if (footer) footer.textContent = `${licences.length} licence${licences.length !== 1 ? 's' : ''}`;
  if (licences.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" style="padding:48px;text-align:center;color:#9ca3af;font-size:13px;">No software licences provisioned yet.</td></tr>';
    return;
  }
  tbody.innerHTML = licences.map((l, i) => {
    const isActive = l.active === true || l.active === 'yes';
    const statusColor = (l.status || '').toLowerCase() === 'active' ? '#16a34a' : '#6b7280';
    const statusBg   = (l.status || '').toLowerCase() === 'active' ? 'rgba(22,163,74,0.1)' : '#f3f4f6';
    const rowBg = i % 2 === 0 ? '' : 'background:#fafafa;';
    return `<tr style="${rowBg}border-bottom:1px solid #f3f4f6;">
      <td style="padding:12px 16px;color:#1a1a1a;font-weight:600;white-space:nowrap;">${l.name || '—'}</td>
      <td style="padding:12px 16px;color:#374151;white-space:nowrap;">${l.email || '—'}</td>
      <td style="padding:12px 16px;color:#6b7280;font-family:monospace;font-size:11px;white-space:nowrap;">${l.ip_address || '—'}</td>
      <td style="padding:12px 16px;">
        <span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:${statusColor};background:${statusBg};padding:2px 8px;border-radius:10px;white-space:nowrap;">
          ${l.status || '—'}
        </span>
      </td>
      <td style="padding:12px 16px;">
        <span style="font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:${isActive?'#16a34a':'#9ca3af'}">
          ${isActive ? 'Yes' : 'No'}
        </span>
      </td>
      <td style="padding:12px 16px;color:#374151;white-space:nowrap;">${l.duration || '—'}</td>
      <td style="padding:12px 16px;color:#374151;white-space:nowrap;">${l.centralbank || '—'}</td>
      <td style="padding:12px 16px;color:#6b7280;font-family:monospace;font-size:11px;white-space:nowrap;">${l.swiftcode || '—'}</td>
      <td style="padding:12px 16px;white-space:nowrap;">
        <span style="font-size:11px;font-weight:600;background:#f3f4f6;color:#374151;padding:2px 8px;border-radius:6px;">${l.license_type || '—'}</span>
      </td>
      <td style="padding:12px 16px;color:#6b7280;white-space:nowrap;">${l.bankID || '—'}</td>
    </tr>`;
  }).join('');
}

function filterSoftwareLicences() {
  const nameFilter = (document.getElementById('licencesNameFilter')?.value || '').toLowerCase();
  const search = (document.getElementById('licencesSearchInput')?.value || '').toLowerCase();
  const filtered = allSoftwareLicences.filter(l => {
    const matchName = !nameFilter || (l.name || '').toLowerCase() === nameFilter;
    const matchSearch = !search || JSON.stringify(l).toLowerCase().includes(search);
    return matchName && matchSearch;
  });
  renderSoftwareLicences(filtered);
}

