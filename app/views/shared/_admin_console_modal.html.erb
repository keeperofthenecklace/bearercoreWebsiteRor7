// CHARTS
// ═══════════════════════════════════════════════════════════════════════════
function renderCorridorVolumeChart() {
  const chartContainer = document.getElementById('corridorVolumeChart');
  const chartTotal     = document.getElementById('corridorVolumeTotal');
  const chartLabel     = document.getElementById('corridorVolumeLabel');
  if (!chartContainer) return;

  // ── Total volume label ──────────────────────────────────────────────────
  const allActiveVolumeUSD = adminClaims
    .filter(c => ACTIVE_STATUSES.includes(c.status))
    .reduce((s, c) => s + getClaimUSDEquivalent(c), 0);
  if (chartLabel) chartLabel.textContent = 'Corridor Volume (USD)';
  if (chartTotal) chartTotal.textContent = formatAmountWithCurrency(allActiveVolumeUSD, 'USD');

  // ── Local date helper ───────────────────────────────────────────────────
  const localDateStr = d =>
    `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;

  // ── Build 7-day buckets ─────────────────────────────────────────────────
  const DAY_NAMES = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const today = new Date();
  const days  = [];

  for (let i = 6; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const bucket = localDateStr(d);
    const claimsOnDay = adminClaims.filter(c =>
      c.created_at &&
      ACTIVE_STATUSES.includes(c.status) &&
      localDateStr(new Date(c.created_at)) === bucket
    );
    days.push({
      label:   i === 0 ? 'Now' : DAY_NAMES[d.getDay()],
      volume:  claimsOnDay.reduce((s, c) => s + getClaimUSDEquivalent(c), 0),
      count:   claimsOnDay.length,
      isToday: i === 0
    });
  }

  const maxVol = Math.max(...days.map(d => d.volume), 1);

  // ── Layout constants (all in px) ────────────────────────────────────────
  // The chart area is split into:
  //   BAR_ZONE  = 80px  — bars live here, growing upward from the bottom
  //   LABEL_H   = 20px  — day name sits below the bar zone
  // Total container height = 100px.
  // Each column is position:relative, height:100px.
  // The bar is position:absolute, bottom:LABEL_H px, so it sits right above the label.
  const TOTAL_H  = 100;
  const LABEL_H  = 20;
  const BAR_ZONE = TOTAL_H - LABEL_H; // 80px

  const cols = days.map(d => {
    const pct    = d.volume / maxVol;
    const barH   = d.volume > 0 ? Math.max(6, Math.round(pct * BAR_ZONE)) : 3;
    const color  = d.isToday ? '#059669' : '#10b981';
    const opac   = d.isToday ? 1 : Math.max(0.25, 0.25 + pct * 0.75);
    const amtTxt = d.volume > 0 ? formatAmountWithCurrency(d.volume, 'USD') : '';

    // Amount label floats just above the bar
    const amtLabelBottom = LABEL_H + barH + 2;
    const amtEl = amtTxt
      ? `<div style="position:absolute;bottom:${amtLabelBottom}px;left:0;right:0;
                     text-align:center;font-size:8px;color:#6b7280;
                     white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                     padding:0 2px;">${amtTxt}</div>`
      : '';

    return `
      <div style="position:relative;flex:1;height:${TOTAL_H}px;min-width:0;">
        ${amtEl}
        <div style="position:absolute;bottom:${LABEL_H}px;left:15%;right:15%;
                    height:${barH}px;
                    background:${color};opacity:${opac.toFixed(2)};
                    border-radius:3px 3px 0 0;"
             title="${d.count} claim${d.count!==1?'s':''} · ${amtTxt||'—'}">
        </div>
        <div style="position:absolute;bottom:0;left:0;right:0;height:${LABEL_H}px;
                    display:flex;align-items:center;justify-content:center;
                    border-top:1px solid #f0f0f0;">
          <span style="font-size:10px;color:#9ca3af;">${d.label}</span>
        </div>
      </div>`;
  }).join('');

  chartContainer.style.cssText =
    `display:flex;align-items:stretch;gap:2px;height:${TOTAL_H}px;` +
    `width:100%;box-sizing:border-box;`;
  chartContainer.innerHTML = cols;
}

function renderIssuanceQueueChart() {
  const chartContainer = document.getElementById('issuanceQueueChart');
  const queueCount = document.getElementById('issuanceQueueCount');
  if (!chartContainer) return;

  // Local date helper (avoids UTC timezone bucketing bug)
  function localDateStr(d) {
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }

  const PENDING_STATUSES = ['submitted', 'pending', 'under_review', 'pre_cleared'];
  const today = new Date();
  const days = [];
  const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  for (let i = 6; i >= 0; i--) {
    const date = new Date(today);
    date.setDate(date.getDate() - i);
    const dateStr = localDateStr(date);

    // Count all active claims that EXISTED on this day (created_at <= dateStr and status is pending)
    // Simpler: count claims created on that day with any active-or-pending status
    const dayClaims = adminClaims.filter(c => {
      if (!c.created_at) return false;
      return localDateStr(new Date(c.created_at)) === dateStr &&
             (PENDING_STATUSES.includes(c.status) || ACTIVE_STATUSES.includes(c.status));
    });

    days.push({
      label: i === 0 ? 'Now' : dayLabels[date.getDay()],
      count: dayClaims.length
    });
  }

  // Total current pending count (not date-filtered)
  const currentPending = adminClaims.filter(c => PENDING_STATUSES.includes(c.status)).length;
  // Override "Now" bucket with real current pending count so it's accurate
  if (days.length > 0) days[days.length - 1].count = currentPending;

  if (queueCount) {
    queueCount.textContent = `${currentPending} Pending request${currentPending !== 1 ? 's' : ''}`;
  }

  // SVG polyline — 300 × 80 viewBox, with 18px left/right padding so first/last labels aren't clipped
  const W = 300, H = 80;
  const PAD = 18; // horizontal padding so "Mon" and "Now" labels fit
  const maxVal = Math.max(...days.map(d => d.count), 1);
  const pts = days.map((d, i) => {
    const x = PAD + (i / (days.length - 1)) * (W - PAD * 2);
    const y = H - 10 - Math.round((d.count / maxVal) * (H - 20)); // 10px top/bottom margin
    return { x, y, count: d.count, label: d.label };
  });

  const polylinePoints = pts.map(p => `${p.x},${p.y}`).join(' ');
  // Filled area polygon: trace the line then close down to baseline
  const areaPoints = [
    ...pts.map(p => `${p.x},${p.y}`),
    `${pts[pts.length-1].x},${H}`,
    `${pts[0].x},${H}`
  ].join(' ');

  const circles = pts.map((p, i) => `
    <circle cx="${p.x}" cy="${p.y}" r="${i === pts.length-1 ? 5 : 3}"
      fill="${i === pts.length-1 ? '#d97706' : '#f59e0b'}">
      <title>${p.label}: ${p.count} claim${p.count !== 1 ? 's' : ''}</title>
    </circle>
    ${p.count > 0 ? `<text x="${p.x}" y="${p.y - 6}" text-anchor="middle" font-size="7" fill="#92400e">${p.count}</text>` : ''}
  `).join('');

  const dayTicks = pts.map(p =>
    `<text x="${p.x}" y="${H - 1}" text-anchor="middle" font-size="7" fill="#9ca3af">${p.label}</text>`
  ).join('');

  chartContainer.style.cssText = 'height:120px;width:100%;display:block;overflow:hidden;';
  chartContainer.innerHTML = `
    <svg width="100%" height="100%" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="display:block;">
      <defs>
        <linearGradient id="queueAreaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.25"/>
          <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.02"/>
        </linearGradient>
        <linearGradient id="queueLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#f59e0b"/>
          <stop offset="100%" stop-color="#d97706"/>
        </linearGradient>
      </defs>
      <!-- Filled area under line -->
      <polygon points="${areaPoints}" fill="url(#queueAreaGrad)"/>
      <!-- Line -->
      <polyline fill="none" stroke="url(#queueLineGrad)" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round"
                points="${polylinePoints}"/>
      <!-- Data points & count labels -->
      ${circles}
      <!-- Day labels -->
      ${dayTicks}
    </svg>
  `;
}

