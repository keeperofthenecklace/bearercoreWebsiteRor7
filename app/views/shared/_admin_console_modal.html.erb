    .admin-charts-row { grid-template-columns: 1fr; }
    .admin-header-search { width: 140px; }
  }

  /* ═══════════════════════════════════════════
     MOBILE  (≤ 600px)
  ═══════════════════════════════════════════ */
  @media (max-width: 600px) {
    #adminConsoleModalOverlay {
      padding: 0 !important;
      align-items: flex-end !important;
    }
    #adminConsoleModalOverlay > div {
      border-radius: 20px 20px 0 0 !important;
      height: 95vh !important;
      max-width: 100% !important;
    }
    /* Sidebar becomes a full-screen drawer */
    #adminConsoleModalOverlay .admin-modal-sidebar {
      position: absolute !important; left: 0 !important; top: 0 !important;
      height: 100% !important; z-index: 50 !important;
      width: 240px !important; min-width: 240px !important;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      border-radius: 0 !important;
    }
    #adminConsoleModalOverlay .admin-modal-sidebar.mobile-open {
      transform: translateX(0);
    }
    #adminSidebarToggle { display: flex !important; }
    /* Stack main content header */
    #adminConsoleModalOverlay .admin-modal-main > div:first-child {
      flex-wrap: wrap; gap: 10px; padding: 14px 16px !important;
    }
