  let toCountry   = claim.corridor?.target_country || claim.corridor?.to_country   || claim.target_country || claim.beneficiary_country || claim.beneficiary?.country || '';
  if (!fromCountry && claim.corridor?.name) {
    const parts = claim.corridor.name.replace(/\s*corridor\s*$/i,'').split(/\s*[→\-]\s*/);
