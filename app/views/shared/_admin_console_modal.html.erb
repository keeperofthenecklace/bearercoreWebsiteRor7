// CORRIDOR MANAGEMENT FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
function refreshCorridorData() {
  loadCorridorManagementData();
}

async function loadCorridorManagementData() {
  console.log('[AdminConsole] loadCorridorManagementData() called');
  try {
    const response = await fetch('/api/v2/corridors', { headers: getAuthHeaders() });
    if (response.ok) {
      const raw = await response.json();
      const corridors = Array.isArray(raw)                          ? raw
                      : Array.isArray(raw.data)                     ? raw.data
                      : (raw.data && Array.isArray(raw.data.corridors)) ? raw.data.corridors
                      : raw.corridors || [];
      renderCorridorManagement(corridors);
    } else {
      renderCorridorManagementError('Failed to load corridors');
    }
  } catch (error) {
    console.error('Error loading corridors:', error);
    renderCorridorManagementError('Error loading corridors');
  }
}

// Pagination state for Corridor Management
let allCorridorsData = [];
let allCorridorsDataUnfiltered = [];
let corridorsCurrentPage = 1;
let corridorsPerPage = 25;

function renderCorridorManagement(corridors) {
  allCorridorsDataUnfiltered = corridors; // Store unfiltered data
  allCorridorsData = corridors; // Set current data
  
  // Clear search input when new data loads
  const searchInput = document.getElementById('corridorSearchInput');
  if (searchInput) searchInput.value = '';
  
  corridorsCurrentPage = 1;
  renderCorridorsPage();
}

function renderCorridorsPage() {
  const tbody = document.getElementById('corridorManagementTableBody');
  if (!tbody) return;
  
  const corridors = allCorridorsData;
  const totalItems = corridors.length;
  const totalPages = Math.ceil(totalItems / corridorsPerPage);
  const startIndex = (corridorsCurrentPage - 1) * corridorsPerPage;
  const endIndex = Math.min(startIndex + corridorsPerPage, totalItems);
  const pageCorridors = corridors.slice(startIndex, endIndex);
  
  if (totalItems === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="padding: 40px; text-align: center; color: #9ca3af;">No corridors found</td></tr>';
    updateCorridorsPaginationUI(0, 0, 0);
    return;
  }
  
  tbody.innerHTML = pageCorridors.map(corridor => {
    const sourceFlag = getFlagEmoji(corridor.source_country) || '🌍';
    const targetFlag = getFlagEmoji(corridor.target_country) || '🌍';
    const statusBadge = corridor.active || corridor.status === 'active' 
      ? '<span style="background: #d1fae5; color: #059669; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Active</span>'
      : '<span style="background: #fee2e2; color: #dc2626; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Inactive</span>';
    const riskBadge = corridor.high_risk 
      ? '<span style="color: #dc2626; font-weight: 500;">High</span>'
      : '<span style="color: #059669; font-weight: 500;">Low</span>';
    
    const dailyLimitVal = corridor.limits?.daily || corridor.daily_limit || 0;
    const perTxLimitVal = corridor.limits?.per_transaction || corridor.per_tx_limit || 0;
    const dailyLimit = dailyLimitVal ? formatAmountWithCurrency(dailyLimitVal, getCurrencyForCountry(corridor.target_country)) : '-';
    const perTxLimit = perTxLimitVal ? formatAmountWithCurrency(perTxLimitVal, getCurrencyForCountry(corridor.target_country)) : '-';
    
    return `
      <tr style="border-bottom: 1px solid #f3f4f6;">
        <td style="padding: 12px 16px; font-size: 13px;">
          <span style="display: flex; align-items: center; gap: 8px;">
            ${sourceFlag} ${getCountryDisplayName(corridor.source_country) || '-'} → ${targetFlag} ${getCountryDisplayName(corridor.target_country) || '-'}
          </span>
        </td>
        <td style="padding: 12px 16px; font-size: 12px; color: #6b7280; font-family: monospace;">${corridor.code || '-'}</td>
        <td style="padding: 12px 16px; font-size: 13px; text-align: right; font-weight: 500;">${dailyLimit}</td>
        <td style="padding: 12px 16px; font-size: 13px; text-align: right; font-weight: 500;">${perTxLimit}</td>
        <td style="padding: 12px 16px; text-align: center;">${statusBadge}</td>
        <td style="padding: 12px 16px; text-align: center;">${riskBadge}</td>
      </tr>
    `;
  }).join('');
  
  updateCorridorsPaginationUI(startIndex + 1, endIndex, totalItems);
}

function updateCorridorsPaginationUI(start, end, total) {
  const totalPages = Math.ceil(total / corridorsPerPage) || 1;
  
  // Update page info
  const pageInfo = document.getElementById('corridorsPageInfo');
  if (pageInfo) {
    pageInfo.textContent = `Page ${corridorsCurrentPage} of ${totalPages}`;
  }
  
  // Update showing info
  const showingInfo = document.getElementById('corridorsShowingInfo');
  if (showingInfo) {
    if (total === 0) {
      showingInfo.textContent = 'No corridors found';
    } else {
      showingInfo.textContent = `Showing ${start}-${end} of ${total} corridors`;
    }
  }
  
  // Update prev/next buttons
  const prevBtn = document.getElementById('corridorsPrevBtn');
  const nextBtn = document.getElementById('corridorsNextBtn');
  
  if (prevBtn) {
    prevBtn.disabled = corridorsCurrentPage <= 1;
    prevBtn.style.opacity = corridorsCurrentPage <= 1 ? '0.5' : '1';
    prevBtn.style.cursor = corridorsCurrentPage <= 1 ? 'not-allowed' : 'pointer';
  }
  
  if (nextBtn) {
    nextBtn.disabled = corridorsCurrentPage >= totalPages;
    nextBtn.style.opacity = corridorsCurrentPage >= totalPages ? '0.5' : '1';
    nextBtn.style.cursor = corridorsCurrentPage >= totalPages ? 'not-allowed' : 'pointer';
  }
  
  // Update page numbers
  const pageNumbers = document.getElementById('corridorsPageNumbers');
  if (pageNumbers) {
    let html = '';
    const maxVisible = 5;
    let startPage = Math.max(1, corridorsCurrentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(totalPages, startPage + maxVisible - 1);
    
    if (endPage - startPage + 1 < maxVisible) {
      startPage = Math.max(1, endPage - maxVisible + 1);
    }
    
    if (startPage > 1) {
      html += `<button onclick="goToCorridorsPage(1)" style="padding: 4px 8px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 12px; cursor: pointer;">1</button>`;
      if (startPage > 2) html += `<span style="padding: 0 4px; color: #9ca3af;">...</span>`;
    }
    
    for (let i = startPage; i <= endPage; i++) {
      const isActive = i === corridorsCurrentPage;
      html += `<button onclick="goToCorridorsPage(${i})" style="padding: 4px 8px; background: ${isActive ? '#1a4d3e' : '#f3f4f6'}; color: ${isActive ? 'white' : '#374151'}; border: 1px solid ${isActive ? '#1a4d3e' : '#e5e7eb'}; border-radius: 4px; font-size: 12px; cursor: pointer; font-weight: ${isActive ? '600' : '400'};">${i}</button>`;
    }
    
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) html += `<span style="padding: 0 4px; color: #9ca3af;">...</span>`;
      html += `<button onclick="goToCorridorsPage(${totalPages})" style="padding: 4px 8px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 12px; cursor: pointer;">${totalPages}</button>`;
    }
    
    pageNumbers.innerHTML = html;
  }
}

function changeCorridorsPage(delta) {
  const totalPages = Math.ceil(allCorridorsData.length / corridorsPerPage);
  const newPage = corridorsCurrentPage + delta;
  
  if (newPage >= 1 && newPage <= totalPages) {
    corridorsCurrentPage = newPage;
    renderCorridorsPage();
  }
}

function goToCorridorsPage(page) {
  corridorsCurrentPage = page;
  renderCorridorsPage();
}

function changeCorridorsPerPage() {
  const select = document.getElementById('corridorsPerPage');
  if (select) {
    corridorsPerPage = parseInt(select.value, 10);
    corridorsCurrentPage = 1;
    renderCorridorsPage();
  }
}

function filterCorridorsTable() {
  const searchInput = document.getElementById('corridorSearchInput');
  const query = (searchInput?.value || '').toLowerCase().trim();
  
  if (!query) {
    allCorridorsData = [...allCorridorsDataUnfiltered];
  } else {
    allCorridorsData = allCorridorsDataUnfiltered.filter(corridor => {
      const sourceCountry = (corridor.source_country || '').toLowerCase();
      const targetCountry = (corridor.target_country || '').toLowerCase();
      const code = (corridor.code || '').toLowerCase();
      const currency = getCurrencyForCountry(corridor.target_country).toLowerCase();
      const sourceCurrency = getCurrencyForCountry(corridor.source_country).toLowerCase();
      
      return sourceCountry.includes(query) || 
             targetCountry.includes(query) || 
             code.includes(query) ||
             currency.includes(query) ||
             sourceCurrency.includes(query);
    });
  }
  
  corridorsCurrentPage = 1;
  renderCorridorsPage();
}

function renderCorridorManagementError(message) {
  const tbody = document.getElementById('corridorManagementTableBody');
  if (tbody) {
    tbody.innerHTML = `<tr><td colspan="6" style="padding: 40px; text-align: center; color: #dc2626;">${message}</td></tr>`;
  }
  updateCorridorsPaginationUI(0, 0, 0);
}

