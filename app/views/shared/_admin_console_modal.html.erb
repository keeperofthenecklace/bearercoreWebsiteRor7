function getClaimAmount(claim) {
  // Try multiple possible locations for the amount
  return parseFloat(claim.trade_details?.amount || claim.amount || claim.trade_amount || 0);
}

// Get USD equivalent of a claim's amount
function getClaimUSDEquivalent(claim) {
  const amount = getClaimAmount(claim);
  const currency = getClaimCurrency(claim);
  return convertToUSD(amount, currency);
}

function updateDashboardStats() {
  // Debug: log claim amounts and FX conversion
  if (adminClaims.length > 0) {
    const sampleClaim = adminClaims[0];
    const sampleAmount = getClaimAmount(sampleClaim);
    const sampleCurrency = getClaimCurrency(sampleClaim);
    const sampleUSD = convertToUSD(sampleAmount, sampleCurrency);
    console.log('[AdminConsole] Sample claim for stats:', {
      amount: sampleAmount,
      currency: sampleCurrency,
      usd_equivalent: sampleUSD,
      fx_rate: PILOT_FX_RATES[sampleCurrency] || 'N/A'
    });
  }
  
  // Total Corridor Volume — all active claims (pending through issuance-eligible) in USD
  const totalVolumeUSD = adminClaims
    .filter(c => ACTIVE_STATUSES.includes(c.status))
    .reduce((sum, claim) => sum + getClaimUSDEquivalent(claim), 0);
  
  const volumeEl = document.getElementById('statTotalVolume');
  if (volumeEl) {
    volumeEl.textContent = formatAmountWithCurrency(totalVolumeUSD, 'USD');
  }
  
  // Pending Claims Count (not approved, not rejected)
  const pendingClaims = adminClaims.filter(c => 
    ['submitted', 'pending', 'under_review', 'pre_cleared'].includes(c.status) &&
    c.status !== 'approved' && c.status !== 'rejected'
  );
  const pendingEl = document.getElementById('statPendingCount');
  if (pendingEl) pendingEl.textContent = pendingClaims.length;
  
  // Daily Limit Utilization - claims created today (local calendar day)
  const localToday = (() => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  })();
  const todayClaims = adminClaims.filter(c => {
    if (!c.created_at || !ACTIVE_STATUSES.includes(c.status)) return false;
    const claimLocal = (() => {
      const d = new Date(c.created_at);
      return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    })();
    return claimLocal === localToday;
  });
  const todayVolumeUSD = todayClaims.reduce((sum, claim) => sum + getClaimUSDEquivalent(claim), 0);
  
  // Convert daily limit to USD equivalent (assuming limits are stored in local currency)
  const totalDailyLimitUSD = 10000000; // $10M USD default daily limit
  const utilPct = Math.min(100, (todayVolumeUSD / totalDailyLimitUSD) * 100);
  
  const dailyUtilEl = document.getElementById('statDailyUtil');
  const dailyUtilBar = document.getElementById('statDailyUtilBar');
  if (dailyUtilEl) {
    dailyUtilEl.textContent = formatAmountWithCurrency(todayVolumeUSD, 'USD');
  }
  if (dailyUtilBar) {
    dailyUtilBar.style.width = `${Math.max(utilPct, 2)}%`;
    dailyUtilBar.style.background = utilPct > 80 ? 'linear-gradient(90deg, #f59e0b, #d97706)' : 'linear-gradient(90deg, #10b981, #059669)';
  }
  
  // Non-Compliance Alerts
  const alertClaims = adminClaims.filter(c => 
    c.compliance_status === 'manual_review' || 
    c.compliance_status === 'blocked' ||
    (c.review_summary?.risk_score || 0) > 50 ||
    (c.aml_risk_score || 0) > 50
  );
  const alertsEl = document.getElementById('statAlerts');
  if (alertsEl) {
    alertsEl.textContent = alertClaims.length;
    alertsEl.style.color = alertClaims.length > 0 ? '#f59e0b' : '#10b981';
  }
  
  // Show notification badge if alerts
  const badge = document.getElementById('adminNotificationBadge');
  if (badge) badge.style.display = alertClaims.length > 0 ? 'block' : 'none';
}

