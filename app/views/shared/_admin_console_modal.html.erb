<%#
  ADMIN CONSOLE - REDESIGNED
  System management and monitoring dashboard.
  READ-ONLY monitoring of trade claims. No transactional authority.
%>

<%# CRITICAL: Define functions BEFORE any HTML with onclick handlers %>
<script>
// ═══════════════════════════════════════════════════════════════════════════
// GLOBAL FUNCTIONS - Must be defined before HTML parsing
// ═══════════════════════════════════════════════════════════════════════════
window.switchAdminTab = function(tabName) {
  console.log('[AdminConsole] switchAdminTab called with:', tabName);
  
  // Update UI - hide all tabs, reset all nav items
  document.querySelectorAll('.admin-tab-content').forEach(function(t) { t.style.display = 'none'; });
  document.querySelectorAll('.admin-nav-item').forEach(function(n) { n.style.background = 'transparent'; n.style.color = 'rgba(255,255,255,0.7)'; });
  
  var tabs = { dashboard:'tabDashboard', corridors:'tabCorridors', institutions:'tabInstitutions', roles:'tabRoles', limits:'tabLimits', settings:'tabSettings', logs:'tabLogs', api:'tabApi' };
  var navs = { dashboard:'navDashboard', corridors:'navCorridors', institutions:'navInstitutions', roles:'navRoles', limits:'navLimits', settings:'navSettings', logs:'navLogs', api:'navApi' };
  
  // Show selected tab
  if (tabs[tabName] && document.getElementById(tabs[tabName])) {
    document.getElementById(tabs[tabName]).style.display = 'block';
    console.log('[AdminConsole] Showing tab:', tabs[tabName]);
  } else {
    console.error('[AdminConsole] Tab not found:', tabs[tabName]);
  }
  
  // Highlight selected nav
  if (navs[tabName] && document.getElementById(navs[tabName])) {
    document.getElementById(navs[tabName]).style.background = 'rgba(255,255,255,0.12)';
    document.getElementById(navs[tabName]).style.color = 'white';
  }
  
  // Load data for specific tabs - use setTimeout to ensure functions are defined
  setTimeout(function() {
    console.log('[AdminConsole] Loading data for tab:', tabName);
    try {
      if (tabName === 'logs') {
        console.log('[AdminConsole] loadAuditLogs exists:', typeof window.loadAuditLogs);
        if (typeof window.loadAuditLogs === 'function') window.loadAuditLogs();
      } else if (tabName === 'corridors') {
        console.log('[AdminConsole] loadCorridorManagementData exists:', typeof window.loadCorridorManagementData);
        if (typeof window.loadCorridorManagementData === 'function') window.loadCorridorManagementData();
      } else if (tabName === 'institutions') {
        console.log('[AdminConsole] loadInstitutions exists:', typeof window.loadInstitutions);
        if (typeof window.loadInstitutions === 'function') window.loadInstitutions();
      } else if (tabName === 'roles') {
        console.log('[AdminConsole] loadSoftwareLicences exists:', typeof window.loadSoftwareLicences);
        if (typeof window.loadSoftwareLicences === 'function') window.loadSoftwareLicences();
      } else if (tabName === 'limits') {
        console.log('[AdminConsole] loadLimitSettings exists:', typeof window.loadLimitSettings);
        if (typeof window.loadLimitSettings === 'function') window.loadLimitSettings();
      } else if (tabName === 'api') {
        console.log('[AdminConsole] loadApiKeys exists:', typeof window.loadApiKeys);
        if (typeof window.loadApiKeys === 'function') window.loadApiKeys();
      }
    } catch(e) {
      console.error('[AdminConsole] Error loading tab data:', e);
    }
  }, 50);
};

window.showAdminConsoleModal = function() {
  console.log('[AdminConsole] Opening modal...');
  var modal = document.getElementById('adminConsoleModalOverlay');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // Use setTimeout to ensure loadAdminDashboard is defined
    setTimeout(function() {
      console.log('[AdminConsole] loadAdminDashboard exists:', typeof window.loadAdminDashboard);
      if (typeof window.loadAdminDashboard === 'function') window.loadAdminDashboard();
    }, 50);
  }
};

window.hideAdminConsoleModal = function() {
  var modal = document.getElementById('adminConsoleModalOverlay');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
};

window.filterAdminClaims = function() {
  setTimeout(function() {
    if (typeof filterAdminClaimsImpl === 'function') filterAdminClaimsImpl();
  }, 10);
};

window.setClaimFilter = function(filter) {
  setTimeout(function() {
    if (typeof setClaimFilterImpl === 'function') setClaimFilterImpl(filter);
  }, 10);
};
</script>

