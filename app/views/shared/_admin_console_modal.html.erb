async function loadInstitutions() {
  try {
    const response = await fetch('/api/v2/institutions');
    if (response.ok) {
      const data = await response.json();
      renderInstitutions(data.institutions || data || []);
    } else {
      deriveInstitutionsFromClaims();
    }
  } catch (error) {
    console.error('Error loading institutions:', error);
    deriveInstitutionsFromClaims();
  }
}

function deriveInstitutionsFromClaims() {
  const institutionMap = {};
  
  adminClaims.forEach(claim => {
    const name = claim.institution_name || claim.sender_institution || 'Unknown';
    const code = claim.institution_code || claim.sender_bank_code || '-';
    const country = claim.source_country || claim.sender_country || '-';
    
    if (!institutionMap[name]) {
      institutionMap[name] = {
        name: name,
        code: code,
        country: country,
        country_code: country,
        claimCount: 0,
        active: true
      };
    }
    institutionMap[name].claimCount++;
  });
  
  renderInstitutions(Object.values(institutionMap));
}

