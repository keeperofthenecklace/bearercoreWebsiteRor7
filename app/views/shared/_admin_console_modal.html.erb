async function loadCorridorData() {
  try {
    const response = await fetch('/api/v2/corridors', { 
      method: 'GET',
      headers: getAuthHeaders(),
      credentials: 'same-origin'
    });
    if (!response.ok) throw new Error('Failed to load corridors');
    const data = await response.json();
    corridorData = data.data || data || [];
    console.log('[AdminConsole] Loaded', corridorData.length, 'corridors from API');
    if (corridorData.length > 0) {
      console.log('[AdminConsole] Sample corridor:', JSON.stringify(corridorData[0], null, 2));
    }
  } catch (e) {
    console.error('[AdminConsole] Error loading corridors:', e);
    corridorData = [];
  }
}

async function loadCorridorQuotaLimits() {
  const tbody = document.getElementById('corridorQuotaTableBody');
  if (!tbody) return;
  
  // ALWAYS derive corridors from claims first - this is more reliable
  let corridors = [];
  
  if (adminClaims.length > 0) {
    const corridorMap = new Map();
    adminClaims.forEach(claim => {
      // Get corridor info from claim
      let from = claim.corridor?.source_country || claim.corridor?.from_country || claim.source_country || claim.originator_country || '';
      let to = claim.corridor?.target_country || claim.corridor?.to_country || claim.target_country || claim.beneficiary_country || claim.beneficiary?.country || '';
      const currency = claim.trade_details?.currency || claim.currency_code || claim.currency || '';
      
      // Parse corridor.name as fallback (e.g. "Morocco-Tanzania Corridor")
      if ((!from || !to) && claim.corridor?.name) {
        const stripped = claim.corridor.name.replace(/\s*corridor\s*$/i, '').trim();
        const parts = stripped.split(/\s*[→\-]\s*/);
        if (parts.length >= 2) {
          if (!from) from = parts[0].trim();
          if (!to)   to   = parts[1].trim();
        }
      }

      // Derive from institution if needed
      if (!from) {
        from = deriveCountryFromInstitution(claim.institution?.name || claim.institution_name || '');
      }
      
      if (from && to) {
        const key = `${from}-${to}`;
        if (!corridorMap.has(key)) {
          corridorMap.set(key, {
            source_country: from,
            target_country: to,
            currency: currency || getCurrencyForCountry(to),
            claims: [],
            daily_limit: claim.corridor?.daily_limit || 500000000,
            monthly_limit: claim.corridor?.monthly_limit || 10000000000
          });
        }
        corridorMap.get(key).claims.push(claim);
      }
    });
    corridors = Array.from(corridorMap.values());
    console.log('[AdminConsole] Derived', corridors.length, 'corridors from claims');
  }
  
  // Fall back to API corridors only if no claims
  if (corridors.length === 0 && corridorData.length > 0) {
    corridors = corridorData;
    console.log('[AdminConsole] Using', corridors.length, 'corridors from API');
  }
  
  // If still no data, show message
  if (corridors.length === 0) {
    tbody.innerHTML = '<tr><td colspan="4" style="padding:30px;text-align:center;color:#9ca3af;">No corridor data available. Submit a trade claim to see corridor information.</td></tr>';
    return;
  }
  
  const activeCorridors = corridors.slice(0, 5);
  
  tbody.innerHTML = activeCorridors.map(corridor => {
    const sourceCountry = corridor.source_country || corridor.from_country || '—';
    const targetCountry = corridor.target_country || corridor.to_country || '—';
    const dailyLimit = corridor.limits?.daily || corridor.daily_limit || 500000000;
    const monthlyLimit = corridor.limits?.monthly || corridor.monthly_limit || 10000000000;
    const currency = corridor.currency || getCurrencyForCountry(targetCountry);
    
    // Calculate usage from claims for this corridor
    const corridorClaims = corridor.claims || [];
    
    // Today's usage
    const today = new Date().toISOString().split('T')[0];
    const todayClaims = corridorClaims.filter(c => 
      c.created_at?.startsWith(today) &&
      ['submitted', 'pending', 'approved', 'pre_cleared'].includes(c.status)
    );
    const dailyUsage = todayClaims.reduce((sum, c) => sum + getClaimAmount(c), 0);
    const dailyRemaining = Math.max(0, dailyLimit - dailyUsage);
    
    // Monthly usage
    const monthStart = new Date();
    monthStart.setDate(1);
    const monthClaims = corridorClaims.filter(c => 
      new Date(c.created_at) >= monthStart &&
      ['submitted', 'pending', 'approved', 'pre_cleared'].includes(c.status)
    );
    const monthlyUsage = monthClaims.reduce((sum, c) => sum + getClaimAmount(c), 0);
    const corridorRemaining = Math.max(0, monthlyLimit - monthlyUsage);
    
    // Compliance status - based on claim statuses in this corridor
    const approvedClaims = corridorClaims.filter(c => c.status === 'approved');
    const pendingClaims = corridorClaims.filter(c => ['submitted', 'pending', 'pre_cleared', 'under_review'].includes(c.status));
    const rejectedClaims = corridorClaims.filter(c => ['rejected', 'blocked', 'cancelled'].includes(c.status));
    
    let complianceStatus, complianceBg, complianceColor, complianceIcon;
    
    const utilizationPct = dailyLimit > 0 ? (dailyUsage / dailyLimit) * 100 : 0;
    
    if (utilizationPct > 100) {
      complianceStatus = 'Limit Exceeded';
      complianceBg = '#fee2e2';
      complianceColor = '#dc2626';
      complianceIcon = '✕';
    } else if (utilizationPct > 80) {
      complianceStatus = 'Near Limit';
      complianceBg = '#fef3c7';
      complianceColor = '#d97706';
      complianceIcon = '⚠';
    } else if (approvedClaims.length > 0 && pendingClaims.length === 0) {
      // All claims approved, none pending
      complianceStatus = 'Approved';
      complianceBg = '#dbeafe';
      complianceColor = '#2563eb';
      complianceIcon = '✓';
    } else if (pendingClaims.length > 0) {
      // Has pending claims
      complianceStatus = 'Pending';
      complianceBg = '#fef3c7';
      complianceColor = '#d97706';
      complianceIcon = '⏳';
    } else {
      // Default - corridor is available/active
      complianceStatus = 'Active';
      complianceBg = '#d1fae5';
      complianceColor = '#059669';
      complianceIcon = '✓';
    }
    
    return `<tr style="border-bottom: 1px solid #f3f4f6;">
      <td style="padding: 14px 20px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 16px;">${getFlagEmoji(sourceCountry)}</span>
          <strong>${getCountryDisplayName(sourceCountry)}</strong>
          <span style="color: #9ca3af;">→</span>
          <span style="font-size: 16px;">${getFlagEmoji(targetCountry)}</span>
          <strong>${getCountryDisplayName(targetCountry)}</strong>
        </div>
      </td>
      <td style="padding: 14px 16px; text-align: right; font-weight: 600;">${currency} ${formatNumber(corridorRemaining)}</td>
      <td style="padding: 14px 16px; text-align: right; color: #6b7280;">${currency} ${formatNumber(dailyRemaining)}</td>
      <td style="padding: 14px 20px; text-align: center;">
        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: ${complianceBg}; color: ${complianceColor}; font-size: 12px; font-weight: 500; border-radius: 20px;">
          ${complianceIcon} ${complianceStatus}
        </span>
      </td>
    </tr>`;
  }).join('');
}

