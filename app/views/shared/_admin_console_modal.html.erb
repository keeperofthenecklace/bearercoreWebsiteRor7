function viewCorridorVolume() {
  const existing = document.getElementById('adminVolumePanel');
  if (existing) existing.remove();

  const localDateStr = d =>
    `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;

  const today    = new Date();
  const todayStr = localDateStr(today);
  const days     = [];

  for (let i = 6; i >= 0; i--) {
    const d      = new Date(today);
    d.setDate(d.getDate() - i);
    const bucket = localDateStr(d);
    const label  = d.toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short' });
    const dayClaims = adminClaims.filter(c =>
      c.created_at && localDateStr(new Date(c.created_at)) === bucket
    );
    const totalUSD = dayClaims.reduce((s, c) => s + getClaimUSDEquivalent(c), 0);
    days.push({ label, dateStr: bucket, count: dayClaims.length, totalUSD });
  }

  const maxUSD = Math.max(...days.map(d => d.totalUSD), 1);
  const BAR_MAX_PX = 80; // px — max bar height inside the 80px tall bar track

  const bars = days.map(d => {
    const pct      = d.totalUSD / maxUSD;
    const barPx    = Math.max(d.totalUSD > 0 ? 4 : 0, Math.round(pct * BAR_MAX_PX));
    const spacePx  = BAR_MAX_PX - barPx;
    const isToday  = d.dateStr === todayStr;
    const barColor = isToday ? '#1a4d3e' : '#6ee7b7';
    const amtTxt   = d.totalUSD > 0 ? formatUSDAmount(d.totalUSD) : '';
    return `
      <div style="display:flex;flex-direction:column;align-items:center;gap:2px;flex:1;min-width:0;">
