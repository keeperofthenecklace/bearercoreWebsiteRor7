function filterAdminClaimsImpl() {
  const search = (document.getElementById('claimSearchInput')?.value || '').toLowerCase();
  filteredAdminClaims = adminClaims.filter(c => {
    if (currentClaimFilter !== 'all') {
      const s = c.status || '', cs = c.compliance_status || '';
      if (currentClaimFilter === 'pending' && !['submitted','pending','under_review','pre_cleared'].includes(s) && !['pending','pre_cleared'].includes(cs)) return false;
      if (currentClaimFilter === 'approved' && s !== 'approved') return false;
      if (currentClaimFilter === 'issuance_eligible' && s !== 'issuance_eligible') return false;
      if (currentClaimFilter === 'manual_review' && cs !== 'manual_review') return false;
      if (currentClaimFilter === 'rejected' && !['rejected','blocked','cancelled'].includes(s)) return false;
    }
    if (search && !(c.reference || '').toLowerCase().includes(search) && !(c.institution?.name || '').toLowerCase().includes(search)) return false;
    return true;
  });
  renderAdminClaims();
}
window.filterAdminClaims = filterAdminClaimsImpl;

function renderAdminClaims() {
  const tbody = document.getElementById('adminClaimsTableBody');
  if (filteredAdminClaims.length === 0) { 
    tbody.innerHTML = '<tr><td colspan="6" style="padding:40px;text-align:center;color:#9ca3af;">No claims found matching your criteria.</td></tr>'; 
    return; 
  }
  
  // Debug: log first claim structure
  if (filteredAdminClaims.length > 0) {
    console.log('[AdminConsole] Sample claim structure:', JSON.stringify(filteredAdminClaims[0], null, 2));
  }
  
  tbody.innerHTML = filteredAdminClaims.slice(0, 8).map(c => {
    const ref = c.reference || 'TC-' + (c.id || '').toString().slice(0,8);
    const inst = c.institution?.name || c.institution_name || c.originator_name || 'Unknown Institution';
    
    // Handle amount - check multiple possible locations
    const amount = getClaimAmount(c);
    const currency = getClaimCurrency(c);
    const amt = `${currency} ${Number(amount).toLocaleString()}`;
    
    // Handle corridor - check multiple possible locations
    let from = c.corridor?.source_country || c.corridor?.from_country || c.source_country || c.originator_country || '';
    let to   = c.corridor?.target_country || c.corridor?.to_country   || c.target_country || c.beneficiary_country || c.beneficiary?.country || '';

    // If embedded corridor is incomplete, look up full corridor from corridorData by ID
    if ((!from || !to) && (c.corridor_id || c.corridor?.id)) {
      const cid = c.corridor_id || c.corridor?.id;
      const matched = corridorData.find(cd => cd.id === cid || cd.corridor_id === cid);
      if (matched) {
        from = from || matched.source_country || matched.from_country || '';
        to   = to   || matched.target_country || matched.to_country   || '';
      }
    }

    // Parse corridor name as fallback (e.g. "GHA → NGA")
    if ((!from || !to) && c.corridor?.name) {
      const parts = c.corridor.name.replace(/\s*corridor\s*$/i,'').split(/\s*[→\-]\s*/);
      if (parts.length >= 2) {
        from = from || parts[0].trim();
        to   = to   || parts[1].trim();
      }
    }

    // Last resort: derive source country from institution name
    if (!from && inst) {
      from = deriveCountryFromInstitution(inst);
    }

    const fromDisplay = from ? toCountryISO(from) : '—';
    const toDisplay   = to   ? toCountryISO(to)   : '—';
    
    const sc = statusConfig(c.status, c.compliance_status);
    const risk = c.review_summary?.risk_score || c.aml_risk_score || c.risk_score || 0;
    const riskLabel = risk > 50 ? 'High' : risk > 20 ? 'Medium' : 'Low';
    const riskColor = risk > 50 ? '#ef4444' : risk > 20 ? '#f59e0b' : '#10b981';
    
    return `<tr style="border-bottom:1px solid #f3f4f6;cursor:pointer;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''" onclick="viewClaimDetails('${c.id}')">
      <td style="padding:14px 20px;font-family:'SF Mono',Monaco,monospace;font-size:12px;font-weight:500;color:#1a4d3e;">${ref}</td>
      <td style="padding:14px 16px;font-size:13px;">${inst}</td>
      <td style="padding:14px 16px;text-align:right;font-weight:600;">${amt}</td>
      <td style="padding:14px 16px;text-align:center;color:#6b7280;font-size:13px;">${fromDisplay} → ${toDisplay}</td>
      <td style="padding:14px 16px;text-align:center;"><span style="padding:4px 10px;background:${sc.bg};color:${sc.color};font-size:11px;font-weight:500;border-radius:6px;">${sc.label}</span></td>
      <td style="padding:14px 20px;text-align:center;font-weight:500;font-size:12px;color:${riskColor};">${riskLabel}</td>
    </tr>`;
  }).join('');
}

// Helper to get claim currency - prioritize corridor target country currency
function getClaimCurrency(claim) {
  // First check explicit non-USD currency fields
  if (claim.trade_details?.currency && claim.trade_details.currency !== 'USD') 
    return claim.trade_details.currency;
  if (claim.currency_code && claim.currency_code !== 'USD') 
    return claim.currency_code;
  if (claim.currency && claim.currency !== 'USD') 
    return claim.currency;

  // Derive from corridor geography — many seeded claims have currency_code="USD"
  // even though the trade is in a local WAEMU/CEMAC/ECOWAS currency.
  // Country-derived currency is more accurate than the stale "USD" default.
  const targetCountry = claim.corridor?.target_country || claim.corridor?.to_country ||
                        claim.target_country || claim.beneficiary_country || claim.beneficiary?.country;
  if (targetCountry) {
    const derived = getCurrencyForCountry(targetCountry);
    if (derived && derived !== 'USD') return derived;
  }

  const sourceCountry = claim.corridor?.source_country || claim.corridor?.from_country || 
                        claim.originator_country;
  if (sourceCountry) {
    const derived = getCurrencyForCountry(sourceCountry);
    if (derived && derived !== 'USD') return derived;
  }

  // Fall back to explicit currency even if USD, or USD as last resort
  return claim.currency_code || claim.trade_details?.currency || claim.currency || 'USD';
}

// Helper to derive country from institution name
function deriveCountryFromInstitution(instName) {
  if (!instName) return '';
  const upper = instName.toUpperCase();
  const mapping = {
    // Ghana banks
    'ABSA BANK OF GHANA': 'GHA', 'ABSA GHANA': 'GHA', 
    'GCB BANK': 'GHA', 'GCB': 'GHA', 'ECOBANK GHANA': 'GHA',
    'STANBIC GHANA': 'GHA', 'STANDARD CHARTERED GHANA': 'GHA', 'FIDELITY BANK GHANA': 'GHA',
    'CAL BANK': 'GHA', 'CONSOLIDATED BANK GHANA': 'GHA', 'GHANA COMMERCIAL': 'GHA',
    // Nigeria banks - 9PSB is a Nigerian Payment Service Bank
    '9 PAYMENT SERVICE BANK': 'NGA', '9PSB': 'NGA', '9 PSB': 'NGA',
    'ZENITH': 'NGA', 'GTB': 'NGA', 'GUARANTY TRUST': 'NGA', 'ACCESS BANK': 'NGA', 
    'FIRST BANK': 'NGA', 'UBA': 'NGA', 'UNITED BANK FOR AFRICA': 'NGA',
    'FIDELITY BANK NIGERIA': 'NGA', 'WEMA BANK': 'NGA', 'STERLING BANK': 'NGA',
    'POLARIS BANK': 'NGA', 'KEYSTONE BANK': 'NGA', 'UNITY BANK': 'NGA',
    // Kenya banks
    'EQUITY BANK': 'KEN', 'EQUITY': 'KEN', 'KCB': 'KEN', 'KENYA COMMERCIAL': 'KEN',
    'COOPERATIVE BANK': 'KEN', 'CO-OPERATIVE': 'KEN', 'ABSA KENYA': 'KEN',
    'STANBIC KENYA': 'KEN', 'STANDARD CHARTERED KENYA': 'KEN',
    // South Africa banks
    'STANDARD BANK': 'ZAF', 'NEDBANK': 'ZAF', 'CAPITEC': 'ZAF', 'FNB': 'ZAF',
    'FIRST NATIONAL BANK': 'ZAF', 'ABSA BANK': 'ZAF', 'INVESTEC': 'ZAF',
    // Country name fallbacks (must be last due to shorter match)
    'GHANA': 'GHA', 'NIGERIA': 'NGA', 'KENYA': 'KEN', 'SOUTH AFRICA': 'ZAF',
    'EGYPT': 'EGY', 'TANZANIA': 'TZA', 'UGANDA': 'UGA', 'ETHIOPIA': 'ETH',
    'BENIN': 'BEN', 'SENEGAL': 'SEN', 'MOROCCO': 'MAR', 'RWANDA': 'RWA'
  };
  
  // Sort by length descending to match longer names first
  const sorted = Object.entries(mapping).sort((a, b) => b[0].length - a[0].length);
  for (const [name, code] of sorted) {
    if (upper.includes(name)) return code;
  }
  return '';
}

function statusConfig(status, compliance) {
  const m = { 
    approved:           { bg:'#d1fae5', color:'#059669', label:'Approved' }, 
    issuance_eligible:  { bg:'#a7f3d0', color:'#065f46', label:'🏦 Issuance-Eligible' },
    pre_cleared:        { bg:'#d1fae5', color:'#059669', label:'Pre-Cleared' }, 
    submitted:          { bg:'#fef3c7', color:'#d97706', label:'Pending' }, 
    pending:            { bg:'#fef3c7', color:'#d97706', label:'Pending' }, 
    under_review:       { bg:'#dbeafe', color:'#2563eb', label:'Under Review' }, 
    manual_review:      { bg:'#fef3c7', color:'#d97706', label:'Manual Review' }, 
    rejected:           { bg:'#fee2e2', color:'#dc2626', label:'Rejected' }, 
    blocked:            { bg:'#fee2e2', color:'#dc2626', label:'Blocked' }, 
    locked:             { bg:'#ede9fe', color:'#6d28d9', label:'🔒 Locked' },
    cancelled:          { bg:'#f3f4f6', color:'#6b7280', label:'Cancelled' } 
  };
  if (compliance === 'manual_review') return m.manual_review;
  if (compliance === 'pre_cleared' && status !== 'approved') return m.pre_cleared;
  return m[status] || { bg:'#f3f4f6', color:'#6b7280', label: status || 'Unknown' };
}

function viewClaimDetails(claimId) {
