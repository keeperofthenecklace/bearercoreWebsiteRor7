function formatNumber(num) {
  if (num >= 1000000000) return (num / 1000000000).toFixed(1) + 'B';
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(0) + 'K';
  return num.toLocaleString();
}

function formatAmountWithCurrency(amount, currency) {
  const curr = currency || 'USD';
  if (amount >= 1000000000) return `${curr} ${(amount / 1000000000).toFixed(1)}B`;
  if (amount >= 1000000) return `${curr} ${(amount / 1000000).toFixed(1)}M`;
  if (amount >= 1000) return `${curr} ${(amount / 1000).toFixed(1)}K`;
  return `${curr} ${amount.toLocaleString()}`;
}

function formatUSDAmount(amount) {
  if (amount >= 1000000000) return `USD ${(amount / 1000000000).toFixed(1)}B`;
  if (amount >= 1000000) return `USD ${(amount / 1000000).toFixed(1)}M`;
  if (amount >= 1000) return `USD ${(amount / 1000).toFixed(1)}K`;
  return `USD ${Number(amount).toLocaleString()}`;
}

function formatCurrency(num) {
  // Generic format without currency prefix - use formatAmountWithCurrency for currency-specific
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
  return num.toLocaleString();
}

