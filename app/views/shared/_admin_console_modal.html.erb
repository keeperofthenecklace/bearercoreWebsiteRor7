// Delete confirmation state
let pendingDeleteId = null;
let pendingDeleteName = '';

async function regenerateApiKey(id) {
  const app = apiKeysData.find(a => a.id === id);
  if (!app) return;
  
  // Use a custom confirm modal would be better, but for now simplified confirm
  if (!confirm(`Regenerate Client Secret for "${app.name}"?\n\nThis will generate a new secret. The old secret will stop working for new token requests.\n\nExisting access tokens remain valid until they expire.`)) {
    return;
  }
  
  try {
    const response = await fetch(`/api/v2/oauth_applications/${id}/regenerate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ revoke_tokens: false })
    });
    
    if (response.ok) {
      const data = await response.json();
      const creds = data.credentials;
      
      // Show credentials in styled modal (regenerate mode)
      showApiCredentialsModal(app.name, creds.client_id, creds.client_secret, true);
      
      loadApiKeys();
    } else {
      const error = await response.json();
      alert(`Failed to regenerate secret: ${error.message || 'Unknown error'}`);
    }
  } catch (error) {
    console.error('Error regenerating API key:', error);
    alert('Error regenerating secret. Please try again.');
  }
}

function revokeApiKey(id) {
  const app = apiKeysData.find(a => a.id === id);
  if (!app) return;
  
  pendingDeleteId = id;
  pendingDeleteName = app.name;
  
  document.getElementById('deleteConfirmAppName').textContent = app.name;
  document.getElementById('deleteConfirmNameRequired').textContent = app.name;
  document.getElementById('deleteConfirmInput').value = '';
  document.getElementById('deleteConfirmBtn').disabled = true;
  document.getElementById('deleteConfirmBtn').style.opacity = '0.5';
  document.getElementById('deleteConfirmBtn').style.cursor = 'not-allowed';
  
  document.getElementById('apiDeleteConfirmModal').style.display = 'flex';
}

function checkDeleteConfirmation() {
  const input = document.getElementById('deleteConfirmInput').value;
  const btn = document.getElementById('deleteConfirmBtn');
  
  if (input === pendingDeleteName) {
    btn.disabled = false;
    btn.style.opacity = '1';
    btn.style.cursor = 'pointer';
  } else {
    btn.disabled = true;
    btn.style.opacity = '0.5';
    btn.style.cursor = 'not-allowed';
  }
}

function closeDeleteConfirmModal() {
  document.getElementById('apiDeleteConfirmModal').style.display = 'none';
  pendingDeleteId = null;
  pendingDeleteName = '';
}

async function confirmDeleteApiKey() {
  if (!pendingDeleteId) return;
  
  try {
    const response = await fetch(`/api/v2/oauth_applications/${pendingDeleteId}`, {
      method: 'DELETE'
    });
    
    if (response.ok) {
      closeDeleteConfirmModal();
      loadApiKeys();
    } else {
      const error = await response.json();
      alert(`Failed to delete application: ${error.message || 'Unknown error'}`);
    }
  } catch (error) {
    console.error('Error deleting API key:', error);
    alert('Error deleting application. Please try again.');
  }
}

function copyToClipboard(text) {
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(() => {
      // Brief visual feedback could be added here
      console.log('Copied to clipboard:', text);
    });
  } else {
    // Fallback for older browsers
    const textarea = document.createElement('textarea');
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
  }
}

