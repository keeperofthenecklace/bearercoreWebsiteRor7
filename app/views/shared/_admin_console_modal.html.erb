    #adminConsoleModalOverlay > div {
      border-radius: 16px !important;
      height: 92vh !important;
    }
    #adminConsoleModalOverlay .admin-modal-sidebar {
      width: 64px !important; min-width: 64px !important;
    }
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-label,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-section-label,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-brand-name,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-user-info,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-role-badge,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-switch-btn-text,
    #adminConsoleModalOverlay .admin-modal-sidebar .sidebar-version {
      display: none !important;
    }
    #adminConsoleModalOverlay .admin-modal-sidebar nav a,
    #adminConsoleModalOverlay .admin-modal-sidebar nav button {
      justify-content: center !important;
      padding: 10px !important;
    }
