async function showCreateApiKeyModal() {
  const appName = prompt('Enter application name (e.g., "Partner Bank API", "Mobile App"):');
  if (!appName || !appName.trim()) return;
  
  const redirectUri = prompt('Enter redirect URI (or leave as default):', 'http://localhost') || 'http://localhost';
  
  try {
    const response = await fetch('/api/v2/oauth_applications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        application: {
          name: appName.trim(),
          redirect_uri: redirectUri,
          scopes: ''
        }
      })
    });
    
    if (response.ok) {
      const data = await response.json();
      const creds = data.credentials;
      
      // Show credentials in styled modal
      showApiCredentialsModal(appName.trim(), creds.client_id, creds.client_secret, false);
      
      // Reload the list
      loadApiKeys();
    } else {
      const error = await response.json();
      alert(`❌ Failed to create API key:\n${error.message || 'Unknown error'}`);
    }
  } catch (error) {
    console.error('Error creating API key:', error);
    alert('❌ Error creating API key. Please try again.');
  }
}

