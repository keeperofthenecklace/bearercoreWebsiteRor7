// ═══════════════════════════════════════════════════════════════════════════
// AUDIT LOGS FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════
let auditLogs = [];
let filteredAuditLogs = [];

async function loadAuditLogs() {
  try {
    const response = await fetch('/api/v2/audit_logs?per_page=100');
    if (response.ok) {
      const data = await response.json();
      auditLogs = data.audit_logs || data || [];
      filteredAuditLogs = auditLogs;
      renderAuditLogs();
    } else {
      console.error('Failed to load audit logs:', response.status);
      renderAuditLogsError('Failed to load audit logs');
    }
  } catch (error) {
    console.error('Error loading audit logs:', error);
    renderAuditLogsError('Error loading audit logs');
  }
}

function filterAuditLogs() {
  const filter = document.getElementById('auditLogFilter').value;
  if (filter === 'all') {
    filteredAuditLogs = auditLogs;
  } else {
    filteredAuditLogs = auditLogs.filter(log => log.action === filter);
  }
  renderAuditLogs();
}

function refreshAuditLogs() {
  loadAuditLogs();
}

function renderAuditLogs() {
  const tbody = document.getElementById('auditLogsTableBody');
  if (!tbody) return;
  
  if (filteredAuditLogs.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" style="padding: 40px; text-align: center; color: #9ca3af;">No audit logs found</td></tr>';
    return;
  }
  
  tbody.innerHTML = filteredAuditLogs.map(log => {
    const timestamp = new Date(log.created_at).toLocaleString();
    const actionBadge = getActionBadge(log.action);
    const details = formatAuditDetails(log);
    const statusBadge = getAuditStatusBadge(log);
    
    return `
      <tr style="border-bottom: 1px solid #f3f4f6;">
        <td style="padding: 12px 16px; font-size: 12px; color: #6b7280;">${timestamp}</td>
        <td style="padding: 12px 16px; font-size: 12px; color: #1a1a1a;">${log.auditable_type || '-'}</td>
        <td style="padding: 12px 16px;">${actionBadge}</td>
        <td style="padding: 12px 16px; font-size: 12px; color: #6b7280; max-width: 300px; overflow: hidden; text-overflow: ellipsis;">${details}</td>
        <td style="padding: 12px 16px; text-align: center;">${statusBadge}</td>
      </tr>
    `;
  }).join('');
}

function getActionBadge(action) {
  const badges = {
    'created': '<span style="background: #dbeafe; color: #1d4ed8; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Created</span>',
    'approved': '<span style="background: #d1fae5; color: #059669; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Approved</span>',
    'rejected': '<span style="background: #fee2e2; color: #dc2626; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Rejected</span>',
    'review_pre_cleared': '<span style="background: #fef3c7; color: #d97706; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Pre-Cleared</span>',
    'review_pending': '<span style="background: #fef3c7; color: #d97706; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Pending</span>',
    'liquidity_locked': '<span style="background: #e0e7ff; color: #4f46e5; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Liquidity Locked</span>'
  };
  return badges[action] || `<span style="background: #f3f4f6; color: #6b7280; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">${action}</span>`;
}

function formatAuditDetails(log) {
  if (log.notes && typeof log.notes === 'string' && log.notes.length > 0 && !log.notes.startsWith('{')) {
    return log.notes;
  }
  
  try {
    const notes = typeof log.notes === 'string' ? JSON.parse(log.notes) : log.notes;
    if (notes && notes.checks_completed) {
      const passed = notes.checks_passed || 0;
      const total = notes.checks_completed.length || 0;
      return `${passed}/${total} checks passed • Risk score: ${notes.risk_score || 0}`;
    }
  } catch (e) {}
  
  const shortId = log.auditable_id ? log.auditable_id.substring(0, 8) : '-';
  return `ID: ${shortId}...`;
}

function getAuditStatusBadge(log) {
  try {
    const notes = typeof log.notes === 'string' ? JSON.parse(log.notes) : log.notes;
    if (notes && notes.all_passed === true) {
      return '<span style="color: #059669;">✓ Pass</span>';
    } else if (notes && notes.all_passed === false) {
      return '<span style="color: #d97706;">⚠ Review</span>';
    }
  } catch (e) {}
  
  if (log.action === 'approved') return '<span style="color: #059669;">✓ Complete</span>';
  if (log.action === 'rejected') return '<span style="color: #dc2626;">✗ Rejected</span>';
  if (log.action === 'created') return '<span style="color: #6b7280;">— New</span>';
  
  return '<span style="color: #6b7280;">—</span>';
}

function renderAuditLogsError(message) {
  const tbody = document.getElementById('auditLogsTableBody');
  if (tbody) {
    tbody.innerHTML = `<tr><td colspan="5" style="padding: 40px; text-align: center; color: #dc2626;">${message}</td></tr>`;
  }
}

