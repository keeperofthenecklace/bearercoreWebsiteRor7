// TRADE CLAIMS
// ═══════════════════════════════════════════════════════════════════════════
async function loadAdminClaims() {
  const tbody = document.getElementById('adminClaimsTableBody');
  tbody.innerHTML = '<tr><td colspan="6" style="padding:40px;text-align:center;color:#9ca3af;">Loading claims...</td></tr>';
  
  try {
    const response = await fetch('/api/v2/trade_claims?per_page=100', { 
      method: 'GET',
      headers: getAuthHeaders(),
      credentials: 'same-origin'
    });
    
    if (!response.ok) {
      if (response.status === 401) throw new Error('Please log in to view claims');
      throw new Error('Failed to load claims');
    }
    
    const data = await response.json();
    adminClaims = data.data || data || [];
    if (!Array.isArray(adminClaims)) adminClaims = [];

    // Normalize: the API returns created_at nested under timestamps.created_at
    // but chart/filter code checks c.created_at at the top level. Hoist it.
    adminClaims = adminClaims.map(c => {
      const ts = c.timestamps || {};
      return {
        ...c,
        created_at: c.created_at || ts.created_at || null,
        updated_at: c.updated_at || ts.approved_at || ts.submitted_at || ts.created_at || null
      };
    });

    console.log('[AdminConsole] Loaded', adminClaims.length, 'claims',
      adminClaims[0] ? `| first created_at: ${adminClaims[0].created_at}` : '');
    filterAdminClaimsImpl();
  } catch (e) {
    console.error('[AdminConsole] Error loading claims:', e);
    tbody.innerHTML = '<tr><td colspan="6" style="padding:40px;text-align:center;color:#ef4444;">Failed to load claims. Check authentication.</td></tr>';
  }
}

