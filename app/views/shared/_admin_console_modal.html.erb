      font-size: 17px !important;
    }
    .admin-header-search { width: 100%; order: 3; }
    /* Scrollable content padding */
    #adminConsoleModalOverlay .admin-modal-main > div:last-child {
      padding: 16px !important;
    }
    .admin-stat-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .admin-charts-row { grid-template-columns: 1fr; }
    /* Claims table: horizontal scroll */
    #adminClaimsTableBody, .admin-claims-table { overflow-x: auto; display: block; }
    .admin-filter-tabs { gap: 4px; }
    .admin-filter-tabs button { font-size: 11px !important; padding: 5px 10px !important; }
  }
</style>

