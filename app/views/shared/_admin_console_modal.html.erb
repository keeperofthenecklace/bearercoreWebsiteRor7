  'Togo':'TGO','Tunisia':'TUN','Uganda':'UGA','Zambia':'ZMB','Zimbabwe':'ZWE',
};

// Returns ISO-3166-1 alpha-3 if the value is a full name; otherwise returns as-is
// so that codes already like "GHA" pass through unchanged.
function toCountryISO(val) {
  if (!val) return val;
  const v = val.toString().trim();
  // Already looks like an ISO code (2-3 uppercase letters)
  if (/^[A-Z]{2,3}$/.test(v)) return v;
  // Try full-name lookup (case-insensitive)
  const key = Object.keys(COUNTRY_NAME_TO_ISO).find(
    k => k.toLowerCase() === v.toLowerCase()
  );
  return key ? COUNTRY_NAME_TO_ISO[key] : v;
}

