async function loadLimitSettings() {
  try {
    const response = await fetch('/api/v2/corridors', { headers: getAuthHeaders() });
    if (response.ok) {
      const raw = await response.json();
      const corridors = Array.isArray(raw)                          ? raw
                      : Array.isArray(raw.data)                     ? raw.data
                      : (raw.data && Array.isArray(raw.data.corridors)) ? raw.data.corridors
                      : raw.corridors || [];
      console.log('[LimitSettings] API Response sample:', JSON.stringify(corridors[0], null, 2));
      console.log('[LimitSettings] Limits structure:', corridors[0]?.limits);
      renderLimitSettings(corridors);
