let apiKeysData = [];
let apiStats = {};

async function loadApiKeys() {
  try {
    // Load OAuth applications from Doorkeeper
    const response = await fetch('/api/v2/oauth_applications');
    if (response.ok) {
      const data = await response.json();
      apiKeysData = data.applications || [];
      renderApiKeys();
      
      // Also load stats
      loadApiStats();
    } else {
      console.warn('OAuth applications endpoint returned:', response.status);
      renderApiKeysError('Unable to load API keys. Check permissions.');
    }
  } catch (error) {
    console.error('Error loading API keys:', error);
    renderApiKeysError('Error connecting to API. Please try again.');
  }
}

async function loadApiStats() {
  try {
    const response = await fetch('/api/v2/oauth_applications/stats');
    if (response.ok) {
      apiStats = await response.json();
      updateApiStatsDisplay();
    }
  } catch (error) {
    console.warn('Could not load API stats:', error);
    // Use calculated stats from loaded data
    updateApiStatsFromData();
  }
}

function updateApiStatsDisplay() {
  const totalKeys = document.getElementById('apiTotalKeys');
  const activeTokens = document.getElementById('apiActiveTokens');
  const tokensToday = document.getElementById('apiTokensToday');
  const tokensAvg = document.getElementById('apiTokensAvg');
  const tokensExpiring = document.getElementById('apiTokensExpiring');
  const rateLimitUsage = document.getElementById('apiRateLimitUsage');
  
  if (totalKeys) totalKeys.textContent = apiStats.total_applications || apiKeysData.length;
  if (activeTokens) activeTokens.textContent = apiStats.active_tokens || 0;
  if (tokensToday) tokensToday.textContent = apiStats.tokens_created_today || 0;
  
  // Update tokens average text
  if (tokensAvg) {
    const avg = apiStats.tokens_avg_per_day || Math.round((apiStats.active_tokens || 0) / 7);
    tokensAvg.textContent = `Avg: ${avg}/day this week`;
  }
  
  // Update expiring tokens
  if (tokensExpiring) {
    const expiring = apiStats.tokens_expiring_soon || 0;
    if (expiring > 0) {
      tokensExpiring.textContent = `${expiring} expiring within 7 days`;
      tokensExpiring.style.color = '#d97706';
    } else {
      tokensExpiring.textContent = 'No tokens expiring soon';
      tokensExpiring.style.color = '#6b7280';
    }
  }
  
  if (rateLimitUsage) {
    const usage = apiStats.rate_limit_percentage || 0;
    rateLimitUsage.textContent = `${usage}%`;
    rateLimitUsage.style.color = usage > 80 ? '#dc2626' : usage > 50 ? '#d97706' : '#10b981';
  }
}

function updateApiStatsFromData() {
  const totalKeys = document.getElementById('apiTotalKeys');
  const activeTokens = document.getElementById('apiActiveTokens');
  const tokensToday = document.getElementById('apiTokensToday');
  const tokensAvg = document.getElementById('apiTokensAvg');
  const tokensExpiring = document.getElementById('apiTokensExpiring');
  
  if (totalKeys) totalKeys.textContent = apiKeysData.length;
  
  // Calculate active tokens from loaded data
  const totalActiveTokens = apiKeysData.reduce((sum, app) => sum + (app.active_tokens_count || 0), 0);
  if (activeTokens) activeTokens.textContent = totalActiveTokens;
  
  // Set defaults for other fields
  if (tokensToday) tokensToday.textContent = '—';
  if (tokensAvg) tokensAvg.textContent = 'Stats loading...';
  if (tokensExpiring) tokensExpiring.textContent = 'Loading...';
}

function renderApiKeys() {
  const tbody = document.getElementById('apiKeysTableBody');
  if (!tbody) return;
  
  if (apiKeysData.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="padding: 40px; text-align: center; color: #9ca3af;">No API applications configured. Click "New API Key" to create one.</td></tr>';
    return;
  }
  
  tbody.innerHTML = apiKeysData.map(app => {
    // Use last_token_created as proxy for "last used"
    const lastUsed = app.last_token_created ? formatTimeAgo(new Date(app.last_token_created)) : 'No tokens';
    const activeTokens = app.active_tokens_count || 0;
    
    // App is considered active if it exists (Doorkeeper doesn't have an active flag)
    const statusBadge = activeTokens > 0
      ? '<span style="background: #d1fae5; color: #059669; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">Active</span>'
      : '<span style="background: #f3f4f6; color: #6b7280; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500;">No Tokens</span>';
    
    // Parse and display scopes
    const scopesList = (app.scopes || '').split(/[\s,]+/).filter(s => s);
    const scopes = scopesList.length > 0 
      ? scopesList.map(scope => 
          `<span style="background: #dbeafe; color: #1d4ed8; padding: 2px 6px; border-radius: 4px; font-size: 10px; margin-right: 4px;">${scope}</span>`
        ).join('')
      : '<span style="background: #f3f4f6; color: #9ca3af; padding: 2px 6px; border-radius: 4px; font-size: 10px;">default</span>';
    
    return `
      <tr style="border-bottom: 1px solid #f3f4f6;">
        <td style="padding: 12px 16px;">
          <div style="font-size: 13px; font-weight: 500; color: #1a1a1a;">${app.name || 'Unnamed Application'}</div>
          <div style="font-size: 11px; color: #9ca3af; margin-top: 2px;">Created ${formatTimeAgo(new Date(app.created_at))}</div>
        </td>
        <td style="padding: 12px 16px;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <code style="font-size: 11px; color: #1a4d3e; background: #f0fdf4; padding: 4px 8px; border-radius: 4px;">${app.uid}</code>
            <button onclick="copyToClipboard('${app.uid_full || app.uid}')" style="padding: 2px 6px; background: none; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 10px; cursor: pointer;" title="Copy full Client ID">📋</button>
          </div>
        </td>
        <td style="padding: 12px 16px;">${scopes}</td>
        <td style="padding: 12px 16px;">
          <div style="font-size: 12px; color: #6b7280;">${lastUsed}</div>
          <div style="font-size: 10px; color: #9ca3af;">${activeTokens} active token${activeTokens !== 1 ? 's' : ''}</div>
        </td>
        <td style="padding: 12px 16px; text-align: center;">${statusBadge}</td>
        <td style="padding: 12px 16px; text-align: center;">
          <div style="display: flex; justify-content: center; gap: 6px;">
            <button onclick="viewApiKey(${app.id})" style="padding: 5px 10px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 11px; cursor: pointer;" title="View Details">View</button>
            <button onclick="regenerateApiKey(${app.id})" style="padding: 5px 10px; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 6px; font-size: 11px; cursor: pointer;" title="Regenerate Secret">Regen</button>
            <button onclick="revokeApiKey(${app.id})" style="padding: 5px 10px; background: #fee2e2; border: 1px solid #fca5a5; border-radius: 6px; font-size: 11px; cursor: pointer;" title="Delete Application">Delete</button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function renderApiKeysError(message) {
