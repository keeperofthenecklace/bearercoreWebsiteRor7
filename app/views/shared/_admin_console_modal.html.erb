// Pagination state for Limit Settings
let allLimitsData = [];
let limitsCurrentPage = 1;
let limitsPerPage = 25;

function renderLimitSettings(corridors) {
  allLimitsData = corridors; // Store all data for pagination
  limitsCurrentPage = 1; // Reset to first page
  renderLimitsPage();
}

function renderLimitsPage() {
  const tbody = document.getElementById('limitSettingsTableBody');
  if (!tbody) return;
  
  const corridors = allLimitsData;
  const totalItems = corridors.length;
  const totalPages = Math.ceil(totalItems / limitsPerPage);
  const startIndex = (limitsCurrentPage - 1) * limitsPerPage;
  const endIndex = Math.min(startIndex + limitsPerPage, totalItems);
  const pageCorridors = corridors.slice(startIndex, endIndex);
  
  console.log('[LimitSettings] Processing', totalItems, 'corridors');
  if (corridors[0]) {
    console.log('[LimitSettings] First corridor limits:', corridors[0].limits);
  }
  
  if (totalItems === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="padding: 30px; text-align: center; color: #9ca3af;">No corridor limits configured</td></tr>';
    updateLimitsPaginationUI(0, 0, 0);
    return;
  }
  
  // Helper to get limit value (handles both nested and flat structure, and string values)
  const getDailyLimit = (c) => parseFloat(c.limits?.daily || c.daily_limit) || 0;
  const getPerTxLimit = (c) => parseFloat(c.limits?.per_transaction || c.per_tx_limit) || 0;
  const getMonthlyLimit = (c) => parseFloat(c.limits?.monthly || c.monthly_limit) || 0;
  
  // Helper to get corridor's currency (based on target country)
  const getCorridorCurrency = (c) => getCurrencyForCountry(c.target_country) || 'USD';
  
  let totalDailyLimitUSD = 0;
  let maxPerTxLimitUSD = 0;
  let totalUsedTodayUSD = 0;
  const today = new Date().toISOString().split('T')[0];
  
  // Calculate totals from ALL corridors, converting to USD
  corridors.forEach(corridor => {
    const currency = getCorridorCurrency(corridor);
    const dailyLimit = getDailyLimit(corridor);
    const perTxLimit = getPerTxLimit(corridor);
    
    // Convert to USD for global totals
    const dailyLimitUSD = convertToUSD(dailyLimit, currency);
    const perTxLimitUSD = convertToUSD(perTxLimit, currency);
    
    totalDailyLimitUSD += dailyLimitUSD;
    if (perTxLimitUSD > maxPerTxLimitUSD) {
      maxPerTxLimitUSD = perTxLimitUSD;
    }
    
    // Calculate used today for this corridor
    const corridorClaims = adminClaims.filter(c => 
      c.created_at?.startsWith(today) &&
      (c.corridor_code === corridor.code || 
       (c.source_country === corridor.source_country && c.target_country === corridor.target_country))
    );
    const usedToday = corridorClaims.reduce((sum, c) => sum + (parseFloat(c.amount) || 0), 0);
    totalUsedTodayUSD += convertToUSD(usedToday, currency);
  });
  
  console.log('[LimitSettings] Total Daily Limit (USD):', totalDailyLimitUSD);
  console.log('[LimitSettings] Max Per-Tx Limit (USD):', maxPerTxLimitUSD);
  
  // Update Global Daily Limit display (in USD)
  const globalDailyEl = document.getElementById('globalDailyLimit');
  if (globalDailyEl) {
    globalDailyEl.textContent = formatUSDAmount(totalDailyLimitUSD);
  }
  
  // Update Per Transaction Max display (in USD - the highest across all corridors)
  const globalPerTxEl = document.getElementById('globalPerTxLimit');
  if (globalPerTxEl) {
    globalPerTxEl.textContent = formatUSDAmount(maxPerTxLimitUSD);
  }
  
  // Update utilization (based on USD values)
  const utilElement = document.getElementById('limitUtilization');
  if (utilElement && totalDailyLimitUSD > 0) {
    const utilPercent = ((totalUsedTodayUSD / totalDailyLimitUSD) * 100).toFixed(1);
    utilElement.textContent = `${utilPercent}%`;
    utilElement.style.color = utilPercent > 80 ? '#d97706' : '#10b981';
  } else if (utilElement) {
    utilElement.textContent = '0%';
    utilElement.style.color = '#10b981';
  }
  
  const today2 = new Date().toISOString().split('T')[0];
  
  // Render current page (showing amounts in local currency)
  tbody.innerHTML = pageCorridors.map(corridor => {
    const currency = getCorridorCurrency(corridor);
    const dailyLimit = getDailyLimit(corridor);
    const perTxLimit = getPerTxLimit(corridor);
    const monthlyLimit = getMonthlyLimit(corridor) || dailyLimit * 30;
    
    const corridorClaims = adminClaims.filter(c => 
      c.created_at?.startsWith(today2) &&
      (c.corridor_code === corridor.code || 
       (c.source_country === corridor.source_country && c.target_country === corridor.target_country))
    );
    const usedToday = corridorClaims.reduce((sum, c) => sum + (parseFloat(c.amount) || 0), 0);
    
    const sourceFlag = getFlagEmoji(corridor.source_country) || '🌍';
    const targetFlag = getFlagEmoji(corridor.target_country) || '🌍';
    
    // Get FX rate for display (1 USD = X local currency)
    const fxRate = PILOT_FX_RATES[currency] || null;
    const fxRateDisplay = currency === 'USD' 
      ? '<span style="color:#9ca3af;">—</span>'
      : fxRate 
        ? `<span style="font-family: monospace; font-size: 12px;" title="1 USD = ${fxRate.toLocaleString()} ${currency}">${currency} ${fxRate >= 1000 ? fxRate.toLocaleString('en', {maximumFractionDigits:2}) : fxRate.toFixed(2)}</span>`
        : '<span style="color:#f59e0b; font-size: 11px;">No rate</span>';
    
    return `
      <tr style="border-bottom: 1px solid #f3f4f6;">
        <td style="padding: 10px 16px; font-size: 13px;">
          ${sourceFlag} ${getCountryDisplayName(corridor.source_country) || '-'} → ${targetFlag} ${getCountryDisplayName(corridor.target_country) || '-'}
        </td>
        <td style="padding: 10px 16px; font-size: 13px; text-align: right;">${formatAmountWithCurrency(dailyLimit, currency)}</td>
        <td style="padding: 10px 16px; font-size: 13px; text-align: right;">${formatAmountWithCurrency(perTxLimit, currency)}</td>
        <td style="padding: 10px 16px; font-size: 13px; text-align: right;">${formatAmountWithCurrency(monthlyLimit, currency)}</td>
        <td style="padding: 10px 16px; font-size: 13px; text-align: right; font-weight: 500; color: ${usedToday > dailyLimit * 0.8 ? '#d97706' : '#1a1a1a'};">${formatAmountWithCurrency(usedToday, currency)}</td>
        <td style="padding: 10px 16px; font-size: 13px; text-align: right; color: #6b7280;">${fxRateDisplay}</td>
      </tr>
    `;
  }).join('');
  
  // Update pagination UI
  updateLimitsPaginationUI(startIndex + 1, endIndex, totalItems);
}

function updateLimitsPaginationUI(start, end, total) {
  const totalPages = Math.ceil(total / limitsPerPage) || 1;
  
  // Update page info
  const pageInfo = document.getElementById('limitsPageInfo');
  if (pageInfo) {
    pageInfo.textContent = `Page ${limitsCurrentPage} of ${totalPages}`;
  }
  
  // Update showing info
  const showingInfo = document.getElementById('limitsShowingInfo');
  if (showingInfo) {
    if (total === 0) {
      showingInfo.textContent = 'No corridors found';
    } else {
      showingInfo.textContent = `Showing ${start}-${end} of ${total} corridors`;
    }
  }
  
  // Update prev/next buttons
  const prevBtn = document.getElementById('limitsPrevBtn');
  const nextBtn = document.getElementById('limitsNextBtn');
  
  if (prevBtn) {
    prevBtn.disabled = limitsCurrentPage <= 1;
    prevBtn.style.opacity = limitsCurrentPage <= 1 ? '0.5' : '1';
    prevBtn.style.cursor = limitsCurrentPage <= 1 ? 'not-allowed' : 'pointer';
  }
  
  if (nextBtn) {
    nextBtn.disabled = limitsCurrentPage >= totalPages;
    nextBtn.style.opacity = limitsCurrentPage >= totalPages ? '0.5' : '1';
    nextBtn.style.cursor = limitsCurrentPage >= totalPages ? 'not-allowed' : 'pointer';
  }
  
  // Update page numbers
  const pageNumbers = document.getElementById('limitsPageNumbers');
  if (pageNumbers) {
    let html = '';
    const maxVisible = 5;
    let startPage = Math.max(1, limitsCurrentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(totalPages, startPage + maxVisible - 1);
    
    if (endPage - startPage + 1 < maxVisible) {
      startPage = Math.max(1, endPage - maxVisible + 1);
    }
    
    if (startPage > 1) {
      html += `<button onclick="goToLimitsPage(1)" style="padding: 4px 8px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 12px; cursor: pointer;">1</button>`;
      if (startPage > 2) html += `<span style="padding: 0 4px; color: #9ca3af;">...</span>`;
    }
    
    for (let i = startPage; i <= endPage; i++) {
      const isActive = i === limitsCurrentPage;
      html += `<button onclick="goToLimitsPage(${i})" style="padding: 4px 8px; background: ${isActive ? '#1a4d3e' : '#f3f4f6'}; color: ${isActive ? 'white' : '#374151'}; border: 1px solid ${isActive ? '#1a4d3e' : '#e5e7eb'}; border-radius: 4px; font-size: 12px; cursor: pointer; font-weight: ${isActive ? '600' : '400'};">${i}</button>`;
    }
    
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) html += `<span style="padding: 0 4px; color: #9ca3af;">...</span>`;
      html += `<button onclick="goToLimitsPage(${totalPages})" style="padding: 4px 8px; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 12px; cursor: pointer;">${totalPages}</button>`;
    }
    
    pageNumbers.innerHTML = html;
  }
}

function changeLimitsPage(delta) {
  const totalPages = Math.ceil(allLimitsData.length / limitsPerPage);
  const newPage = limitsCurrentPage + delta;
  
  if (newPage >= 1 && newPage <= totalPages) {
    limitsCurrentPage = newPage;
    renderLimitsPage();
  }
}

function goToLimitsPage(page) {
  limitsCurrentPage = page;
  renderLimitsPage();
}

function changeLimitsPerPage() {
  const select = document.getElementById('limitsPerPage');
  if (select) {
    limitsPerPage = parseInt(select.value, 10);
    limitsCurrentPage = 1; // Reset to first page
    renderLimitsPage();
  }
}

// Store original unfiltered data
let allLimitsDataUnfiltered = [];

function filterLimitsTable() {
  const searchInput = document.getElementById('limitsSearchInput');
  const query = (searchInput?.value || '').toLowerCase().trim();
  
  if (!query) {
    // No search query - restore original data
    allLimitsData = [...allLimitsDataUnfiltered];
  } else {
    // Filter corridors by source country, target country, currency, or code
    allLimitsData = allLimitsDataUnfiltered.filter(corridor => {
      const sourceCountry = (corridor.source_country || '').toLowerCase();
      const targetCountry = (corridor.target_country || '').toLowerCase();
      const code = (corridor.code || '').toLowerCase();
      const currency = getCurrencyForCountry(corridor.target_country).toLowerCase();
      const sourceCurrency = getCurrencyForCountry(corridor.source_country).toLowerCase();
      
      return sourceCountry.includes(query) || 
             targetCountry.includes(query) || 
             code.includes(query) ||
             currency.includes(query) ||
             sourceCurrency.includes(query);
    });
  }
  
  limitsCurrentPage = 1; // Reset to first page when filtering
  renderLimitsPage();
}

// Override renderLimitSettings to store unfiltered data
const originalRenderLimitSettings = renderLimitSettings;
renderLimitSettings = function(corridors) {
  allLimitsDataUnfiltered = corridors; // Store unfiltered data
  allLimitsData = corridors; // Set current data
  
  // Clear search input when new data loads
  const searchInput = document.getElementById('limitsSearchInput');
  if (searchInput) searchInput.value = '';
  
  limitsCurrentPage = 1;
  renderLimitsPage();
};

