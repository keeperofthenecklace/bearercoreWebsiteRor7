  'CVE': 101.50,    // Cape Verdean Escudo
  'MRU': 39.50,     // Mauritanian Ouguiya
  
  // Central African currencies (non-CFA)
  'CDF': 2750.00,   // Congolese Franc
  'AOA': 825.00,    // Angolan Kwanza
  'STN': 22.50,     // São Tomé and Príncipe Dobra
  
  // Island nations
  'MUR': 45.50,     // Mauritian Rupee
  'MGA': 4550.00,   // Malagasy Ariary
  
  // Base currency
  'USD': 1.00,
};

// Convert amount to USD using FX rates
function convertToUSD(amount, currency) {
  if (!amount || amount === 0) return 0;
  if (!currency || currency === 'USD') return amount;
  
  const upperCurrency = currency.toUpperCase();
  
  // Try API rates first, then fallback to pilot rates
  const rate = fxRates[upperCurrency]?.usd_rate || PILOT_FX_RATES[upperCurrency];
  
  if (!rate) {
    console.warn(`[FX] No rate found for ${upperCurrency}, returning original amount`);
    return amount;
  }
  
  // rate is "1 USD = X currency", so USD = amount / rate
  return amount / rate;
}

// Load FX rates from API
async function loadFxRates() {
  try {
    const response = await fetch('/api/v2/fx_rates/current', {
      method: 'GET',
      headers: getAuthHeaders(),
      credentials: 'same-origin'
    });
    
    if (response.ok) {
      const data = await response.json();
      fxRates = data.data || {};
      console.log('[AdminConsole] Loaded FX rates:', Object.keys(fxRates).length, 'currencies');
    }
  } catch (e) {
    console.log('[AdminConsole] FX rates API not available, using pilot rates');
  }
}

// ── Refresh FX Rates from External API ──────────────────────────────────────
// Hits open.er-api.com directly, updates PILOT_FX_RATES in memory,
// then persists to the DB via POST /api/v2/fx_rates/bulk_upsert
async function refreshFxRatesFromAPI() {
  const btn    = document.getElementById('refreshFxBtn');
  const icon   = document.getElementById('refreshFxIcon');
  const status = document.getElementById('fxRatesStatus');

  if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.style.cursor = 'not-allowed'; }
  if (icon) { icon.style.animation = 'spin 1s linear infinite'; }
  if (status) { status.textContent = 'Fetching rates…'; status.style.color = '#6b7280'; }

  try {
    // 1. Fetch live rates from open.er-api.com (base: USD)
    const extRes = await fetch('https://open.er-api.com/v6/latest/USD');
    if (!extRes.ok) throw new Error(`ER-API returned ${extRes.status}`);
    const extData = await extRes.json();

    if (extData.result !== 'success') throw new Error(extData['error-type'] || 'API error');

    const allRates      = extData.rates || {};
    const publishedAt   = extData.time_last_update_utc || new Date().toISOString();
    const effectiveDate = (extData.time_last_update_utc
      ? new Date(extData.time_last_update_utc)
      : new Date()
    ).toISOString().slice(0, 10);

    // 2. Filter to African currencies we care about (superset of pilot list)
    const AFRICA_CURRENCIES = [
      'NGN','KES','GHS','ZAR','EGP','XOF','ETB','TZS','UGX','RWF',
      'MAD','DZD','TND','LYD','SDG','ZMW','ZWL','MWK','MZN','NAD',
      'BWP','LSL','SZL','AOA','XAF','CDF','MGA','MUR','KMF','SCR',
      'STN','BIF','DJF','SOS','SSP','ERN','GNF','SLL','LRD','MRU',
      'CVE','SLE','GMD'
    ];

    const africaRates = {};
    AFRICA_CURRENCIES.forEach(code => {
      if (allRates[code]) africaRates[code] = allRates[code];
    });
    africaRates['USD'] = 1.0;

    // 3. Update in-memory pilot rates so table re-renders immediately
    Object.assign(PILOT_FX_RATES, africaRates);

    // 4. Re-render the corridor table with fresh rates
    if (typeof renderLimitsPage === 'function') renderLimitsPage();

    // 5. Persist to DB via bulk_upsert
    const payload = {
      fx_rates: Object.entries(africaRates).map(([code, rate]) => ({
        base_currency:  'USD',
        quote_currency: code,
        rate:           rate,
        inverse_rate:   code === 'USD' ? 1.0 : parseFloat((1.0 / rate).toFixed(8)),
        source:         'ER_API',
        source_url:     'https://open.er-api.com/v6/latest/USD',
        effective_date: effectiveDate,
        published_at:   publishedAt,
        is_current:     true,
        metadata:       { provider: 'open.er-api.com', triggered_by: 'admin_console' }
      }))
    };

    let savedCount = 0;
    try {
      const dbRes = await fetch('/api/v2/fx_rates/bulk_upsert', {
        method:      'POST',
        headers:     getAuthHeaders(),
        credentials: 'same-origin',
        body:        JSON.stringify(payload)
      });
      if (dbRes.ok) {
        const dbData = await dbRes.json();
        savedCount = dbData.saved || 0;
      } else {
        console.warn('[FxRates] DB upsert returned', dbRes.status);
      }
    } catch (dbErr) {
      console.warn('[FxRates] DB upsert failed (rates still updated in memory):', dbErr.message);
    }

    // 6. Update status label
    const rateCount = Object.keys(africaRates).length;
    const timeStr   = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    if (status) {
      if (savedCount > 0) {
        status.textContent = `✓ ${rateCount} rates refreshed · ${savedCount} saved · ${timeStr}`;
        status.style.color = '#10b981';
      } else {
        status.textContent = `✓ ${rateCount} rates live · DB pending · ${timeStr}`;
        status.style.color = '#f59e0b';
      }
    }

  } catch (err) {
    console.error('[FxRates] Refresh failed:', err);
    if (status) {
      status.textContent = `✗ ${err.message}`;
      status.style.color = '#ef4444';
    }
  } finally {
    if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer'; }
    if (icon) { icon.style.animation = ''; }
  }
}


function getAdminToken() {
  // Token passed from Rails via environment variable, with fallback
  const envToken = '<%= ENV["ADMIN_API_TOKEN"] || ENV["ACCESS_TOKEN"] || "" %>';
  // Fallback if ENV not loaded (remove in production)
  return envToken || 'wOJLHO7nXlO7IOqUI8mX9nfYMQi_S8EmqKMwUOh-FO8';
}

function getAuthHeaders() {
  const headers = { 'Accept': 'application/json', 'Content-Type': 'application/json' };
  
  // Add CSRF token for Rails
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  if (csrfToken) headers['X-CSRF-Token'] = csrfToken;
  
  // Add Bearer token
  const token = getAdminToken();
  if (token && token !== '') {
    headers['Authorization'] = `Bearer ${token}`;
  }
  
  console.log('[AdminConsole] Using token:', token ? token.substring(0, 10) + '...' : 'NONE');
  
  return headers;
}

