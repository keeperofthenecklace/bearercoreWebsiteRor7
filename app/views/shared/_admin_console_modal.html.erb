    position:fixed;inset:0;background:rgba(0,0,0,0.5);
    backdrop-filter:blur(6px);z-index:99999;
    display:flex;align-items:center;justify-content:center;padding:20px;
  `;
  overlay.onclick = e => { if (e.target === overlay) overlay.remove(); };

  overlay.innerHTML = `
    <div style="
      background:#fff;border-radius:20px;width:100%;max-width:620px;
      box-shadow:0 24px 64px rgba(0,0,0,0.25);overflow:hidden;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    ">
      <div style="background:linear-gradient(135deg,#1a4d3e,#2d6a4f);padding:22px 24px;display:flex;justify-content:space-between;align-items:center;">
        <div>
