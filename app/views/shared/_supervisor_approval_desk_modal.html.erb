    background:rgba(0,0,0,0.55);backdrop-filter:blur(8px);
    display:flex;align-items:center;justify-content:center;padding:20px;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  `;
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:20px;width:100%;max-width:480px;max-height:85vh;overflow-y:auto;box-shadow:0 32px 80px rgba(0,0,0,0.3);animation:slideUpFade 0.18s ease;">
      <div style="background:${headerBg};padding:22px 24px 18px;border-radius:20px 20px 0 0;position:sticky;top:0;">
        <div style="font-size:11px;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Supervisor Approval Desk</div>
        <div style="font-size:18px;font-weight:700;color:#fff;">${headerIcon} ${headerTitle}</div>
        <div style="font-size:12px;color:rgba(255,255,255,0.75);margin-top:4px;line-height:1.4;">${headerSub}</div>
      </div>
      ${bodyHtml}
      <div style="padding:16px 24px 22px;display:flex;justify-content:flex-end;">
        <button id="approvalResultClose" style="
          background:${footerBtnColor};color:#fff;border:none;border-radius:10px;
          padding:12px 32px;font-size:14px;font-weight:700;cursor:pointer;
        ">${footerBtnLabel}</button>
      </div>
    </div>`;

  document.body.appendChild(overlay);
  document.getElementById('approvalResultClose').onclick = () => overlay.remove();
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
  document.addEventListener('keydown', function esc(e) {
    if (e.key === 'Escape') { overlay.remove(); document.removeEventListener('keydown', esc); }
  });
}

// ── Styled approval confirmation modal ──────────────────────────────────────
// Returns a Promise<boolean> — resolves true (confirm) or false (cancel).
function showApprovalConfirmModal(claim, notes) {
  return new Promise(resolve => {
    const existing = document.getElementById('approvalConfirmOverlay');
    if (existing) existing.remove();

    const ref      = claim.reference || 'TC-' + (claim.id || '').toString().slice(0,8);
    const inst     = claim.institution?.name || claim.originator_name || '—';

    // Currency: always trust the claim's own currency_code first.
    // Only fall back to country-derived currency when it's genuinely absent.
    // (resolveCorridorCurrency can map Sudan → USD which would override EGP, XOF etc.)
    const toCountry   = claim.corridor?.target_country || claim.corridor?.to_country
                     || claim.beneficiary_country || claim.trade_details?.target_country || '';
    const fromCountry = claim.corridor?.source_country || claim.corridor?.from_country
                     || claim.trade_details?.source_country || '';
    const rawCurrency = claim.currency_code || claim.trade_details?.currency || '';
    const currency    = rawCurrency ||
                        resolveCorridorCurrency(toCountry) ||
                        resolveCorridorCurrency(fromCountry) ||
                        'USD';

    const rawAmt   = claim.trade_details?.amount || claim.amount || 0;
    const amount   = parseFloat(rawAmt).toLocaleString();
    const corridor = claim.corridor?.name ||
                     (fromCountry && toCountry ? `${fromCountry} → ${toCountry}` : '—');
    const notesDisplay = notes?.trim()
      ? `<div style="margin-top:12px;padding:10px 12px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;font-size:12px;color:#14532d;line-height:1.5;">
           <span style="font-weight:600;display:block;margin-bottom:2px;">Decision Notes</span>${notes.trim()}
         </div>`
      : `<div style="margin-top:12px;padding:10px 12px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;font-size:12px;color:#92400e;">
           ⚠ No decision notes entered. Consider adding notes for the audit trail.
         </div>`;

    const overlay = document.createElement('div');
    overlay.id = 'approvalConfirmOverlay';
    overlay.style.cssText = `
      position: fixed; inset: 0; z-index: 999999;
      background: rgba(0,0,0,0.55); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center; padding: 20px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    `;

    overlay.innerHTML = `
      <div style="
        background: #fff; border-radius: 20px; width: 100%; max-width: 460px;
        box-shadow: 0 32px 80px rgba(0,0,0,0.3); overflow: hidden;
        animation: slideUpFade 0.18s ease;
      ">
        <!-- Header -->
        <div style="background: linear-gradient(135deg,#1a4d3e,#2d6a4f); padding: 22px 24px 18px;">
          <div style="font-size:11px;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">
            Supervisor Approval Desk
          </div>
          <div style="font-size:19px;font-weight:700;color:#fff;">Confirm Trade Claim Approval</div>
          <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-top:4px;">
            This action is irreversible. Please review before confirming.
          </div>
        </div>

        <!-- Claim summary -->
        <div style="padding: 20px 24px 0;">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:4px;">
            <div style="background:#f9fafb;border-radius:10px;padding:12px;">
              <div style="font-size:10px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px;">Reference</div>
              <div style="font-size:13px;font-weight:700;color:#1a4d3e;font-family:monospace;">${ref}</div>
            </div>
            <div style="background:#f9fafb;border-radius:10px;padding:12px;">
              <div style="font-size:10px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px;">Amount</div>
              <div style="font-size:13px;font-weight:700;color:#1d1d1f;">${currency} ${amount}</div>
            </div>
            <div style="background:#f9fafb;border-radius:10px;padding:12px;grid-column:span 2;">
              <div style="font-size:10px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px;">Institution</div>
              <div style="font-size:13px;font-weight:600;color:#1d1d1f;">${inst}</div>
            </div>
            <div style="background:#f9fafb;border-radius:10px;padding:12px;grid-column:span 2;">
              <div style="font-size:10px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:3px;">Corridor</div>
              <div style="font-size:13px;font-weight:600;color:#1d1d1f;">${corridor}</div>
            </div>
          </div>

          ${notesDisplay}

          <!-- What happens on approval -->
          <div style="margin-top:12px;padding:10px 12px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;font-size:11px;color:#0369a1;line-height:1.6;">
            <span style="font-weight:700;display:block;margin-bottom:3px;">⚙ System actions on approval</span>
            All 5 issuance eligibility gating conditions will be evaluated immediately.<br>
            If all pass, the claim transitions to <strong>Issuance-Eligible</strong> automatically.
          </div>
        </div>

        <!-- Actions -->
        <div style="padding:20px 24px 24px;display:flex;gap:10px;">
          <button id="approvalConfirmCancel" style="
            flex:1;padding:13px;background:#f3f4f6;color:#374151;
            border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;
          ">Cancel</button>
          <button id="approvalConfirmOK" style="
            flex:2;padding:13px;
            background:linear-gradient(135deg,#059669,#1a4d3e);
            color:white;border:none;border-radius:10px;
            font-size:14px;font-weight:700;cursor:pointer;
            display:flex;align-items:center;justify-content:center;gap:8px;
            box-shadow:0 4px 14px rgba(5,150,105,0.35);
          ">✓ Approve Trade Claim</button>
        </div>
      </div>
      <style>
        @keyframes slideUpFade {
          from { opacity:0; transform:translateY(16px) scale(0.97); }
          to   { opacity:1; transform:translateY(0)    scale(1); }
        }
      </style>
    `;

    document.body.appendChild(overlay);

    const cleanup = (result) => {
      overlay.remove();
      resolve(result);
    };

    document.getElementById('approvalConfirmOK').onclick     = () => cleanup(true);
    document.getElementById('approvalConfirmCancel').onclick = () => cleanup(false);
    overlay.addEventListener('click', e => { if (e.target === overlay) cleanup(false); });

    // Keyboard: Enter = confirm, Escape = cancel
    const keyHandler = e => {
      if (e.key === 'Enter')  { document.removeEventListener('keydown', keyHandler); cleanup(true); }
      if (e.key === 'Escape') { document.removeEventListener('keydown', keyHandler); cleanup(false); }
    };
    document.addEventListener('keydown', keyHandler);
  });
}

async function supervisorApproveClaim() {
  if (!selectedSupervisorClaimData) { alert('Please select a claim first'); return; }
  const notes = document.getElementById('supervisorDecisionNotes').value;

  // ── Styled confirmation modal (replaces browser confirm()) ───────────────
  const confirmed = await showApprovalConfirmModal(selectedSupervisorClaimData, notes);
  if (!confirmed) return;

  const btn = document.getElementById('btnApprove');
  const originalText = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '⏳ Approving...';

  try {
    const res = await fetch(`/api/v2/trade_claims/${selectedSupervisorClaimData.id}/approve`, {
      method: 'POST',
      headers: getSupervisorAuthHeaders(),
      body: JSON.stringify({ notes })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || data.error || `Failed: ${res.status}`);

    const finalStatus    = data.status || 'compliance_cleared';
    const mintingReady   = finalStatus === 'ready_to_mint';
    const liqInsufficient = finalStatus === 'insufficient_corridor_liquidity';

    // ── Merge updated claim data and re-render checks panel ──
    selectedSupervisorClaimData = {
      ...selectedSupervisorClaimData,
      ...data.data,
      status:            finalStatus,
      gating_conditions: data.eligibility?.gates || {},
      eligibility:       data.eligibility || {}
    };
    populateReviewChecks(selectedSupervisorClaimData);

    // ── Update the "Updates" panel ──
    const updatesEl  = document.getElementById('approvalUpdates');
    const issuanceEl = document.getElementById('issuanceEligibleUpdate');

    if (mintingReady) {
      updatesEl.innerHTML = `
        <div><span style="color:#22c55e;">✓</span> Supervisor approval — compliance cleared</div>
        <div><span style="color:#22c55e;">✓</span> Corridor protocol check passed</div>
        <div><span style="color:#22c55e;">✓</span> Corridor headroom earmarked</div>
        <div><span style="color:#22c55e;">✓</span> status → <strong>ready_to_mint</strong></div>
      `;
      updatesEl.style.background  = '#f0fdf4';
      updatesEl.style.color       = '#166534';
      updatesEl.style.borderColor = '#bbf7d0';
      if (issuanceEl) issuanceEl.style.display = 'block';
      btn.innerHTML = '🏦 Approved → Ready to Mint';

    } else if (liqInsufficient) {
      const note = data.data?.verification_note || 'Corridor headroom insufficient.';
      updatesEl.innerHTML = `
        <div><span style="color:#22c55e;">✓</span> Supervisor approval — compliance cleared</div>
        <div><span style="color:#f59e0b;">⚠</span> Protocol check: corridor headroom insufficient</div>
        <div style="font-size:11px;color:#92400e;padding:6px 0 0 12px;line-height:1.5;">${note}</div>
        <div style="margin-top:8px;font-size:11px;color:#92400e;font-weight:600;">
          Governor liquidity injection required. Use Re-Evaluate after injection to advance to Ready to Mint.
        </div>
      `;
      updatesEl.style.background  = '#fffbeb';
      updatesEl.style.color       = '#92400e';
      updatesEl.style.borderColor = '#fde68a';
      if (issuanceEl) issuanceEl.style.display = 'none';
      btn.innerHTML = '⚠ Compliance Cleared — Liquidity Insufficient';

    } else {
      updatesEl.innerHTML = `<div><span style="color:#22c55e;">✓</span> status → ${finalStatus}</div>`;
      updatesEl.style.background  = '#f9fafb';
      updatesEl.style.color       = '#374151';
      updatesEl.style.borderColor = '#e5e7eb';
      btn.innerHTML = '✅ Processing...';
    }

    // Update in-memory queue
    const idx = supervisorClaims.findIndex(c => c.id === selectedSupervisorClaimData.id);
    if (idx !== -1) supervisorClaims[idx] = { ...supervisorClaims[idx], ...data.data, status: finalStatus };
    applySupervisorFilters();

    showApprovalResultModal({
      mintingReady,
      liqInsufficient,
      reference:    selectedSupervisorClaimData.reference || finalStatus,
      gates:        data.eligibility?.gates || {},
      verifyNote:   data.data?.verification_note || '',
      message:      data.message || ''
    });

  } catch (e) {
    showApprovalResultModal({ error: true, errorMessage: e.message });
    btn.disabled = false;
    btn.innerHTML = originalText;
  }
}

// ── Re-Evaluate Eligibility ──────────────────────────────────────────────────
// Called when the supervisor clicks "Re-Evaluate" after a gate was previously
// failed and the underlying issue has since been corrected (e.g. compliance
// team cleared an AML flag in the back-office system).
//
// Maps to: POST /api/v2/trade_claims/:id/re_evaluate
// The backend runs Claims::IssuanceEligibilityService.re_evaluate(claim)
// which re-runs all 5 gates and transitions to issuance_eligible if all pass.
async function supervisorReEvaluateClaim() {
  if (!selectedSupervisorClaimData) return;

  const btn = document.getElementById('btnReEvaluate');
  if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Evaluating...'; }

  try {
    const res = await fetch(`/api/v2/trade_claims/${selectedSupervisorClaimData.id}/re_evaluate`, {
      method:  'POST',
      headers: getSupervisorAuthHeaders(),
      body:    JSON.stringify({})
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || data.error || `HTTP ${res.status}`);

    const issuanceEligible = data.issuance_eligible === true;
    const finalStatus      = data.status || selectedSupervisorClaimData.status;

    // ── Merge new gate results back into claim object ──
    selectedSupervisorClaimData = {
      ...selectedSupervisorClaimData,
      status:            finalStatus,
      gating_conditions: data.eligibility?.gates || selectedSupervisorClaimData.gating_conditions || {},
      eligibility:       data.eligibility || {}
    };

    // Re-render the gating panel + lifecycle table with fresh results
    populateReviewChecks(selectedSupervisorClaimData);

    // ── Update the "Updates" panel ──
    const updatesEl = document.getElementById('approvalUpdates');
    const issuanceEl = document.getElementById('issuanceEligibleUpdate');

    if (issuanceEligible) {
      // All gates now pass — claim has transitioned to issuance_eligible
      updatesEl.innerHTML = `
        <div><span style="color:#22c55e;">✓</span> Re-evaluation complete</div>
        <div><span style="color:#22c55e;">✓</span> status → issuance_eligible</div>
        <div><span style="color:#22c55e;">✓</span> All 5 gates passed</div>
        <div><span style="color:#22c55e;">✓</span> issuance_authorization created</div>
      `;
      updatesEl.style.background  = '#f0fdf4';
      updatesEl.style.color       = '#166534';
      updatesEl.style.borderColor = '#bbf7d0';
      if (issuanceEl) issuanceEl.style.display = 'block';

      // Update queue row to reflect new status
      const idx = supervisorClaims.findIndex(c => c.id === selectedSupervisorClaimData.id);
      if (idx !== -1) supervisorClaims[idx] = { ...supervisorClaims[idx], status: finalStatus };
      applySupervisorFilters();

      // Swap button state — Approve is no longer needed
      const approveBtn = document.getElementById('btnApprove');
      if (approveBtn) { approveBtn.innerHTML = '🏦 Issuance-Eligible'; approveBtn.disabled = true; }
      if (btn) { btn.style.display = 'none'; }

    } else {
      // Some gates still failing — show which ones remain blocked
      const failedConditions = data.eligibility?.failed_conditions || [];
      updatesEl.innerHTML = `
        <div><span style="color:#f59e0b;">⟳</span> Re-evaluation complete — still blocked</div>
        ${failedConditions.map(f =>
          `<div style="font-size:11px;color:#92400e;padding-left:12px;">• ${f}</div>`
        ).join('')}
        <div style="font-size:11px;color:#6b7280;margin-top:6px;padding-left:12px;">
          Re-evaluate again once those conditions are corrected.
        </div>
      `;
      updatesEl.style.background  = '#fffbeb';
      updatesEl.style.color       = '#92400e';
      updatesEl.style.borderColor = '#fde68a';
      if (issuanceEl) issuanceEl.style.display = 'none';
      if (btn) { btn.disabled = false; btn.innerHTML = '⟳ Re-Evaluate'; }
    }

  } catch (e) {
    const failMsg = `Re-evaluation failed: ${e.message}`;
    const updatesEl = document.getElementById('approvalUpdates');
    if (updatesEl) {
      updatesEl.innerHTML = `<div style="color:#dc2626;">⚠ ${failMsg}</div>`;
      updatesEl.style.background = '#fef2f2';
    }
    if (btn) { btn.disabled = false; btn.innerHTML = '⟳ Re-Evaluate'; }
    console.error('[supervisorReEvaluateClaim]', e);
  }
}

async function supervisorRejectClaim() {
  if (!selectedSupervisorClaimData) { alert('Please select a claim first'); return; }
  const notes = document.getElementById('supervisorDecisionNotes').value;
  if (!notes.trim()) { alert('Please provide a reason in Decision Notes.'); return; }
  if (!confirm('Reject this trade claim?')) return;
  
  try {
    const res = await fetch(`/api/v2/trade_claims/${selectedSupervisorClaimData.id}/reject`, {
      method: 'POST',
      headers: getSupervisorAuthHeaders(),
      body: JSON.stringify({ notes, reason: notes })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || data.error || `Failed: ${res.status}`);
    alert('⛔ Claim rejected successfully.');
    loadSupervisorClaims();
    document.getElementById('sdWorkspace').style.display = 'none';
    document.getElementById('sdNoSelection').style.display = 'flex';
    selectedSupervisorClaim = null;
    selectedSupervisorClaimData = null;
  } catch (e) { alert('Error rejecting claim: ' + e.message); }
}

