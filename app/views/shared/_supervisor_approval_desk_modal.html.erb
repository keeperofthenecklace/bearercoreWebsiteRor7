    footerBtnColor = '#059669';

  } else {
    // Fallback — unexpected intermediate state
    headerBg   = 'linear-gradient(135deg,#374151,#6b7280)';
    headerIcon = '⚙';
    headerTitle = 'Processing';
    headerSub   = `${reference} — claim is processing through the approval pipeline.`;

