<%# ─── Track Submissions — read-only Trade Claim Status Monitor ─────────────────
    Read-only. Fetches GET /api/v2/trade_claims/my_submissions from SmartCHEQ, which
    is strictly enclosed to the authenticated operator's own institution_swift.
    No create/approve/reject actions — monitoring only. %>
<div id="trackSubmissionsModal"
     style="display:none; position:fixed; inset:0; z-index:10000; background:rgba(6,15,35,0.55); backdrop-filter:blur(2px); align-items:flex-start; justify-content:center; padding:40px 16px; overflow-y:auto;">
  <div style="background:#ffffff; width:100%; max-width:1040px; border-radius:16px; box-shadow:0 24px 60px rgba(0,0,0,0.35); overflow:hidden;">

    <!-- Header -->
    <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:20px 24px; background:linear-gradient(135deg,#0f766e 0%,#134e4a 100%);">
      <div style="display:flex; align-items:center; gap:12px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5eead4" stroke-width="1.6"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
        <div>
          <h2 style="margin:0; color:#fff; font-size:17px; font-weight:600;">Track Submissions</h2>
          <p id="trackScopeLabel" style="margin:3px 0 0; color:rgba(255,255,255,0.75); font-size:12px;">Your institution's trade claims — read-only status monitor</p>
        </div>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <button onclick="loadMySubmissions()" title="Refresh" style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.14); color:#fff; border:1px solid rgba(255,255,255,0.25); font-size:12px; font-weight:600; padding:8px 12px; border-radius:8px; cursor:pointer;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
          Refresh
        </button>
        <button onclick="closeTrackSubmissionsModal()" title="Close" style="background:rgba(255,255,255,0.14); color:#fff; border:1px solid rgba(255,255,255,0.25); font-size:16px; line-height:1; padding:7px 11px; border-radius:8px; cursor:pointer;">&times;</button>
      </div>
    </div>

    <!-- Body -->
    <div style="padding:0; max-height:70vh; overflow-y:auto;">
      <!-- States -->
      <div id="trackLoading" style="display:none; padding:56px 24px; text-align:center; color:#64748b; font-size:14px;">Loading your submissions…</div>
      <div id="trackError" style="display:none; padding:40px 24px; text-align:center; color:#b91c1c; font-size:14px;"></div>
      <div id="trackEmpty" style="display:none; padding:56px 24px; text-align:center; color:#64748b; font-size:14px;">No trade claims submitted by your institution yet.</div>

      <!-- Table -->
      <div id="trackTableWrap" style="display:none; overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:13px;">
          <thead>
            <tr style="background:#f1f5f9; color:#475569; text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:0.04em;">
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">Reference</th>
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">Amount</th>
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">Destination Corridor</th>
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">Submitted</th>
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">State</th>
              <th style="padding:12px 16px; font-weight:700; position:sticky; top:0; background:#f1f5f9;">Decision Notes</th>
            </tr>
          </thead>
          <tbody id="trackRows"></tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div style="padding:12px 24px; background:#f8fafc; border-top:1px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between; gap:12px;">
      <span id="trackCount" style="font-size:12px; color:#64748b;"></span>
      <span style="font-size:11px; color:#94a3b8;">Read-only • scoped to your institution</span>
    </div>
  </div>
</div>

<script>
(function () {
  function trackApiBase() {
    var w = window.SC_API_BASE && String(window.SC_API_BASE).trim();
    if (w) return w;
    var meta = document.querySelector('meta[name="smartcheq-browser-api-base"]');
    var m = meta && meta.getAttribute('content') && meta.getAttribute('content').trim();
    if (m) return m;
    return 'https://api.smartcheq.com';
  }

  function trackToken() {
    if (typeof getAccessToken === 'function') { try { return getAccessToken(); } catch (e) {} }
    var meta = document.querySelector('meta[name="api-token"]');
    if (meta && meta.getAttribute('content')) return meta.getAttribute('content').trim();
    try { return localStorage.getItem('access_token') || ''; } catch (e) { return ''; }
  }

  // Lifecycle-state → badge palette. Groups the state machine into progress bands.
  var STATE_STYLES = {
    draft:                          ['#475569', '#e2e8f0'],
    submitted:                      ['#1d4ed8', '#dbeafe'],
    pending:                        ['#1d4ed8', '#dbeafe'],
    pending_review:                 ['#1d4ed8', '#dbeafe'],
    under_review:                   ['#7c3aed', '#ede9fe'],
    pre_cleared:                    ['#0369a1', '#e0f2fe'],
    manual_review:                  ['#b45309', '#fef3c7'],
    pending_clarification:          ['#b45309', '#fef3c7'],
    insufficient_corridor_liquidity:['#c2410c', '#ffedd5'],
    approved:                       ['#047857', '#d1fae5'],
    locked:                         ['#047857', '#d1fae5'],
    issuance_eligible:              ['#047857', '#d1fae5'],
    processing:                     ['#0f766e', '#ccfbf1'],
    completed:                      ['#065f46', '#a7f3d0'],
    settled:                        ['#065f46', '#a7f3d0'],
    cancelled:                      ['#6b7280', '#f3f4f6'],
    rejected:                       ['#b91c1c', '#fee2e2'],
    blocked:                        ['#b91c1c', '#fee2e2']
  };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[ch];
    });
  }

  function stateBadge(status) {
    var key = String(status || '').toLowerCase();
    var pal = STATE_STYLES[key] || ['#475569', '#e2e8f0'];
    var label = key.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
    return '<span style="display:inline-block; font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px; white-space:nowrap; color:' +
           pal[0] + '; background:' + pal[1] + ';">' + esc(label) + '</span>';
  }

  function fmtAmount(amount, ccy) {
    var n = Number(amount);
    var num = isFinite(n) ? n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : esc(amount);
    return '<span style="font-variant-numeric:tabular-nums; font-weight:600; color:#0f172a;">' + num + '</span>' +
           (ccy ? ' <span style="color:#64748b; font-size:12px;">' + esc(ccy) + '</span>' : '');
  }

  function fmtDate(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return esc(iso);
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function show(id, on) { var el = document.getElementById(id); if (el) el.style.display = on ? '' : 'none'; }

  window.showTrackSubmissionsModal = function () {
    var m = document.getElementById('trackSubmissionsModal');
    if (m) { m.style.display = 'flex'; }
    loadMySubmissions();
  };

  window.closeTrackSubmissionsModal = function () {
    var m = document.getElementById('trackSubmissionsModal');
    if (m) m.style.display = 'none';
  };

  window.loadMySubmissions = function () {
    show('trackTableWrap', false); show('trackEmpty', false); show('trackError', false);
    show('trackLoading', true);
    document.getElementById('trackCount').textContent = '';

    fetch(trackApiBase() + '/api/v2/trade_claims/my_submissions', {
      method: 'GET',
      headers: { 'Accept': 'application/json', 'Authorization': 'Bearer ' + trackToken() }
    })
    .then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (body) {
        return { ok: res.ok, status: res.status, body: body };
      });
    })
    .then(function (r) {
      show('trackLoading', false);
      if (!r.ok) {
        var msg = (r.body && r.body.error && r.body.error.message) ||
                  (r.status === 401 ? 'Your session has expired. Please sign in again to view your submissions.'
                                    : 'Could not load submissions (HTTP ' + r.status + ').');
        var el = document.getElementById('trackError');
        el.textContent = msg; show('trackError', true);
        return;
      }
      var subs = (r.body && r.body.submissions) || [];
      var scope = r.body && r.body.institution_swift;
      if (scope) document.getElementById('trackScopeLabel').textContent =
        "Trade claims originated by " + scope + " — read-only status monitor";

      if (!subs.length) { show('trackEmpty', true); return; }

      var rows = subs.map(function (s) {
        var corridor = (s.corridor && (s.corridor.display || s.corridor.name)) || '—';
        var notes = s.decision_notes
          ? '<span style="color:#334155;">' + esc(s.decision_notes) + '</span>'
          : '<span style="color:#94a3b8;">—</span>';
        return '<tr style="border-bottom:1px solid #eef2f7;">' +
          '<td style="padding:12px 16px; font-weight:600; color:#0f172a; white-space:nowrap;">' + esc(s.reference || '—') + '</td>' +
          '<td style="padding:12px 16px; white-space:nowrap;">' + fmtAmount(s.amount, s.currency_code) + '</td>' +
          '<td style="padding:12px 16px; white-space:nowrap; color:#334155; font-weight:500;">' + esc(corridor) + '</td>' +
          '<td style="padding:12px 16px; white-space:nowrap; color:#475569;">' + fmtDate(s.submitted_at) + '</td>' +
          '<td style="padding:12px 16px;">' + stateBadge(s.status) + '</td>' +
          '<td style="padding:12px 16px; max-width:280px;">' + notes + '</td>' +
        '</tr>';
      }).join('');

      document.getElementById('trackRows').innerHTML = rows;
      show('trackTableWrap', true);
      document.getElementById('trackCount').textContent =
        subs.length + (subs.length === 1 ? ' submission' : ' submissions');
    })
    .catch(function () {
      show('trackLoading', false);
      var el = document.getElementById('trackError');
      el.textContent = 'Network error — could not reach the submissions service.';
      show('trackError', true);
    });
  };

  // Close on backdrop click / Esc.
  document.addEventListener('click', function (e) {
    var m = document.getElementById('trackSubmissionsModal');
    if (m && e.target === m) window.closeTrackSubmissionsModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var m = document.getElementById('trackSubmissionsModal');
      if (m && m.style.display !== 'none') window.closeTrackSubmissionsModal();
    }
  });
})();
</script>
